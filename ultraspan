#!/bin/bash
set -u

# ============================================
# Ultraspan - Ultimate Multi‑Monitor Wallpaper Utility
# ============================================
# Version 5.3.3 - Brought to you by hisovereign
# ============================================

# ----------------------------------------------------------------------
# Configuration (can be overridden in ~/.config/ultraspan/config)
# ----------------------------------------------------------------------
declare -A CONFIG
CONFIG[mode]="zoom"
CONFIG[bg_type]="blur"
CONFIG[blur]=15
CONFIG[color]="#000000"
CONFIG[fullscreen_pause]="true"
CONFIG[random_interval]=30
CONFIG[refresh_interval]=480
CONFIG[multi_random]="false"
CONFIG[backend]="gsettings"
CONFIG[max_cache_mb]=2000          # max cache size in MB, 0 = no limit
CONFIG[magick_memory]="2GiB"       # ImageMagick memory limit
CONFIG[config_version]=1           # config version for migration
CONFIG[per_workspace]="false"      # enable per‑workspace wallpapers


VERSION="5.3.3"
CONFIG_DIR="${HOME}/.config/ultraspan"
CONFIG_FILE="${CONFIG_DIR}/config"
CACHE_DIR="${HOME}/.cache/ultraspan"
STATE_FILE="${CONFIG_DIR}/state"
RANDOM_FILE="${CONFIG_DIR}/random"
REFRESH_FILE="${CONFIG_DIR}/refresh"
LOCK_FILE="/tmp/ultraspan.lock"
FULLSCREEN_FILE="${CONFIG_DIR}/fullscreen"
LAYOUT_MONITOR_PIDFILE="${CONFIG_DIR}/layout_monitor.pid"
LOG_FILE="${CACHE_DIR}/ultraspan.log"
PID_DIR="/run/user/${UID}/ultraspan"
DAEMON_PIDFILE="${PID_DIR}/daemon.pid"

DEBUG=false
VERBOSE=false
WATCHDOG_LIMIT=1000000

# ----------------------------------------------------------------------
# ImageMagick detection & memory limit
# ----------------------------------------------------------------------
if command -v magick &>/dev/null; then
    IM_CMD="magick"
    IM_IDENTIFY="magick identify"
else
    IM_CMD="convert"
    IM_IDENTIFY="identify"
fi

# ----------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------
log() {
    local level="$1"; shift
    local msg="$*"
    local timestamp
    timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
    if [[ "$level" == "ERROR" ]]; then
        printf "[%s] %s: %s\n" "$timestamp" "$level" "$msg" >&2
    elif [[ "$DEBUG" == "true" ]] || [[ "$level" == "INFO" ]]; then
        printf "[%s] %s: %s\n" "$timestamp" "$level" "$msg" >> "$LOG_FILE"
    fi
    if [[ "$VERBOSE" == "true" ]] && [[ "$level" != "ERROR" ]]; then
        printf "[%s] %s\n" "$timestamp" "$msg"
    fi
}

debug_log() {
    [[ "$DEBUG" == "true" ]] && log "DEBUG" "$@"
}

# ----------------------------------------------------------------------
# Locking - blocking wait, stale detection
# ----------------------------------------------------------------------
acquire_lock() {
    if [[ -f "$LOCK_FILE" ]]; then
        local lock_pid
        lock_pid="$(cat "$LOCK_FILE" 2>/dev/null)"
        if [[ -n "$lock_pid" ]] && ! kill -0 "$lock_pid" 2>/dev/null; then
            log "INFO" "Removing stale lock file (PID $lock_pid not alive)."
            rm -f "$LOCK_FILE"
        fi
    fi
    exec 9>"$LOCK_FILE" || { log "ERROR" "Cannot open lock file"; exit 1; }
    flock 9 || { log "ERROR" "Failed to acquire lock"; exit 1; }
    echo "$$" > "$LOCK_FILE"
    debug_log "Lock acquired (PID $$)."
}

release_lock() {
    flock -u 9 2>/dev/null
    exec 9>&-
    debug_log "Lock released."
}

cleanup() {
    release_lock
    if [[ -f "$DAEMON_PIDFILE" ]] && [[ "$(cat "$DAEMON_PIDFILE")" == "$$" ]]; then
        log "INFO" "Daemon cleaning up: killing children."
        pkill -P $$ 2>/dev/null
        rm -f "$DAEMON_PIDFILE"
    fi
    rm -f "$LAYOUT_MONITOR_PIDFILE"
}
trap cleanup EXIT

# ----------------------------------------------------------------------
# Config helpers (with migration)
# ----------------------------------------------------------------------
migrate_config() {
    local current_version="${CONFIG[config_version]:-0}"
    if (( current_version < 1 )); then
        log "INFO" "Migrating config to version 1"
        # Ensure new keys exist
        CONFIG[max_cache_mb]=2000
        CONFIG[magick_memory]="2GiB"
        CONFIG[per_workspace]="false"
        CONFIG[config_version]=1
        update_config config_version 1   # rewrite config file
    fi
}

load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        local key value
        while IFS='=' read -r key value; do
            key="${key## }"; key="${key%% }"
            value="${value## }"; value="${value%% }"
            if [[ -n "$key" ]] && [[ -n "$value" ]]; then
                CONFIG["$key"]="$value"
            fi
        done < "$CONFIG_FILE"
    fi
    # Set defaults for missing keys
    : "${CONFIG[mode]:=zoom}"
    : "${CONFIG[bg_type]:=blur}"
    : "${CONFIG[blur]:=15}"
    : "${CONFIG[color]:=#000000}"
    : "${CONFIG[fullscreen_pause]:=true}"
    : "${CONFIG[random_interval]:=30}"
    : "${CONFIG[refresh_interval]:=480}"
    : "${CONFIG[multi_random]:=false}"
    : "${CONFIG[backend]:=gsettings}"
    : "${CONFIG[max_cache_mb]:=2000}"
    : "${CONFIG[magick_memory]:=2GiB}"
    : "${CONFIG[per_workspace]:=false}"
    : "${CONFIG[config_version]:=1}"
    # Run migration if needed
    migrate_config
}

update_config() {
    local key="$1" value="$2"
    CONFIG["$key"]="$value"
    local temp_file
    temp_file="$(mktemp)"
    for k in "${!CONFIG[@]}"; do
        printf "%s=%s\n" "$k" "${CONFIG[$k]}" >> "$temp_file"
    done
    mv "$temp_file" "$CONFIG_FILE"
    log "INFO" "Config updated: $key = $value"
}

# ----------------------------------------------------------------------
# Cache size management
# ----------------------------------------------------------------------
trim_cache() {
    local max_mb="${CONFIG[max_cache_mb]}"
    [[ "$max_mb" -eq 0 ]] && return   # no limit
    local current_size
    current_size="$(du -sm "$CACHE_DIR" 2>/dev/null | cut -f1)"
    while [[ "$current_size" -gt "$max_mb" ]]; do
        local oldest
        oldest="$(find "$CACHE_DIR" -type f -printf '%T@ %p\n' | sort -n | head -1 | cut -d' ' -f2)"
        [[ -z "$oldest" ]] && break
        rm -f "$oldest"
        current_size="$(du -sm "$CACHE_DIR" 2>/dev/null | cut -f1)"
    done
}

# ----------------------------------------------------------------------
# Monitor geometry (with sanity check)
# ----------------------------------------------------------------------
get_monitor_info() {
    unset MONITOR_NAMES MONITOR_X MONITOR_Y MONITOR_W MONITOR_H
    MIN_X=99999; MIN_Y=99999; MAX_X=0; MAX_Y=0
    local index=0
    while IFS= read -r line; do
        if [[ $line =~ ([0-9]+:[[:space:]]+[\+\*]*)([A-Za-z0-9-]+)[[:space:]]+([0-9]+)\/[0-9]+x([0-9]+)\/[0-9]+\+([0-9]+)\+([0-9]+) ]]; then
            MONITOR_NAMES[index]="${BASH_REMATCH[2]}"
            MONITOR_X[index]="${BASH_REMATCH[5]}"
            MONITOR_Y[index]="${BASH_REMATCH[6]}"
            MONITOR_W[index]="${BASH_REMATCH[3]}"
            MONITOR_H[index]="${BASH_REMATCH[4]}"
            (( MONITOR_X[index] < MIN_X )) && MIN_X=${MONITOR_X[index]}
            (( MONITOR_Y[index] < MIN_Y )) && MIN_Y=${MONITOR_Y[index]}
            local x2=$((MONITOR_X[index] + MONITOR_W[index]))
            local y2=$((MONITOR_Y[index] + MONITOR_H[index]))
            (( x2 > MAX_X )) && MAX_X=$x2
            (( y2 > MAX_Y )) && MAX_Y=$y2
            ((index++))
        fi
    done < <(xrandr --current --listmonitors 2>/dev/null)
    MONITOR_COUNT=$index
    if [[ $MONITOR_COUNT -eq 0 ]]; then
        log "ERROR" "No monitors detected. Cannot continue."
        return 1
    fi
}

# ----------------------------------------------------------------------
# Workspace helpers
# ----------------------------------------------------------------------
get_current_workspace() {
    if ! command -v xdotool &>/dev/null; then
        log "WARN" "xdotool not found; per‑workspace features may not work correctly."
        echo 0
        return
    fi
    xdotool get_desktop 2>/dev/null || echo 0
}

get_state_file() {
    local ws="${1:-$(get_current_workspace)}"
    echo "${CONFIG_DIR}/state_workspace_${ws}"
}

get_total_span() {
    get_monitor_info || exit 1
    TOTAL_WIDTH=$((MAX_X - MIN_X))
    TOTAL_HEIGHT=$((MAX_Y - MIN_Y))
    debug_log "Span: ${TOTAL_WIDTH}x${TOTAL_HEIGHT}"
}

# ----------------------------------------------------------------------
# Filename safety: replace pipe character
# ----------------------------------------------------------------------
safe_filename() {
    printf '%s\n' "${1//|/%PIPE%}"
}

# ----------------------------------------------------------------------
# Image processing helpers
# ----------------------------------------------------------------------
get_file_mtime() {
    stat -c %Y "$1" 2>/dev/null || echo "0"
}

process_image_for_area() {
    local image="$1" area_w="$2" area_h="$3" mode="$4"
    local outfile
    outfile="$(mktemp)" || { log "ERROR" "Failed to create temp file"; return 1; }

    local img_w img_h
    img_w="$($IM_IDENTIFY -format "%w" "$image" 2>/dev/null)" || img_w=0
    img_h="$($IM_IDENTIFY -format "%h" "$image" 2>/dev/null)" || img_h=0

    case "$mode" in
        zoom)
            if [[ "$image" =~ \.(jpe?g)$ ]]; then
                $IM_CMD "$image" -define jpeg:size="${area_w}x${area_h}" \
                    -resize "${area_w}x${area_h}^" -gravity center -extent "${area_w}x${area_h}" "$outfile"
            else
                $IM_CMD "$image" -resize "${area_w}x${area_h}^" -gravity center -extent "${area_w}x${area_h}" "$outfile"
            fi
            ;;
        fit)
            $IM_CMD "$image" -resize "${area_w}x${area_h}" "$outfile"
            ;;
        center)
            local fit_w fit_h
            if (( img_w > img_h )); then
                fit_w=$(( area_w * 80 / 100 ))
                fit_h=$(( img_h * fit_w / img_w ))
            else
                fit_h=$(( area_h * 80 / 100 ))
                fit_w=$(( img_w * fit_h / img_h ))
            fi
            (( fit_w > area_w )) && fit_w=$area_w
            (( fit_h > area_h )) && fit_h=$area_h
            $IM_CMD "$image" -resize "${fit_w}x${fit_h}" "$outfile"
            ;;
        *) log "ERROR" "Unknown mode: $mode"; return 1 ;;
    esac
    echo "$outfile"
}

# ----------------------------------------------------------------------
# Set wallpaper
# ----------------------------------------------------------------------
set_wallpaper() {
    local image="$1" mode="${2:-${CONFIG[mode]}}" force="${3:-false}"
    [[ -f "$image" ]] || { log "ERROR" "File not found: $image"; return 1; }

    log "INFO" "Setting wallpaper: $(basename "$image") (mode $mode)"
    get_total_span

    mkdir -p "$CACHE_DIR" "$CONFIG_DIR"

    local abs_image
    abs_image="$(readlink -f "$image")"
    local mtime
    mtime="$(get_file_mtime "$abs_image")"
    local safe_abs
    safe_abs="$(safe_filename "$abs_image")"
    local key_string="${safe_abs}|${mtime}|${mode}|${CONFIG[bg_type]}|${CONFIG[blur]}|${CONFIG[color]}|${TOTAL_WIDTH}x${TOTAL_HEIGHT}"
    local cache_key
    cache_key="$(echo -n "$key_string" | md5sum | cut -d' ' -f1)"
    local CACHE_FILE="${CACHE_DIR}/${cache_key}.jpg"

    # Trim cache before writing new file
    trim_cache

    if [[ "$force" == "true" ]] || [[ ! -f "$CACHE_FILE" ]]; then
        log "INFO" "Processing image (cache miss or forced)..."
        local img_w img_h
        img_w="$($IM_IDENTIFY -format "%w" "$image" 2>/dev/null)" || img_w=0
        img_h="$($IM_IDENTIFY -format "%h" "$image" 2>/dev/null)" || img_h=0
        debug_log "Original: ${img_w}x${img_h}"

        case "$mode" in
            zoom)
                if [[ "$image" =~ \.(jpe?g)$ ]]; then
                    $IM_CMD "$image" -define jpeg:size="${TOTAL_WIDTH}x${TOTAL_HEIGHT}" \
                        -resize "${TOTAL_WIDTH}x${TOTAL_HEIGHT}^" -gravity center -extent "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" -quality 95 "$CACHE_FILE"
                else
                    $IM_CMD "$image" -resize "${TOTAL_WIDTH}x${TOTAL_HEIGHT}^" -gravity center -extent "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" -quality 95 "$CACHE_FILE"
                fi
                ;;
            fit)
                if [[ "${CONFIG[bg_type]}" == "blur" ]]; then
                    $IM_CMD "$image" \
                        \( -clone 0 -resize "${TOTAL_WIDTH}x${TOTAL_HEIGHT}^" -gravity center -extent "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" -blur "0x${CONFIG[blur]}" \) \
                        \( -clone 0 -resize "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" \) \
                        -delete 0 -gravity center -composite -quality 95 "$CACHE_FILE"
                else
                    $IM_CMD "$image" -resize "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" -background "${CONFIG[color]}" -gravity center -extent "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" -quality 95 "$CACHE_FILE"
                fi
                ;;
            center)
                if [[ "${CONFIG[bg_type]}" == "blur" ]]; then
                    local blur_bg center_fg
                    blur_bg="$(mktemp)"; center_fg="$(mktemp)"
                    $IM_CMD "$image" -resize "${TOTAL_WIDTH}x${TOTAL_HEIGHT}^" -gravity center -extent "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" -blur "0x${CONFIG[blur]}" "$blur_bg"
                    local fit_w fit_h
                    if (( img_w > img_h )); then
                        fit_w=$((TOTAL_WIDTH * 80 / 100))
                        fit_h=$((img_h * fit_w / img_w))
                    else
                        fit_h=$((TOTAL_HEIGHT * 80 / 100))
                        fit_w=$((img_w * fit_h / img_h))
                    fi
                    (( fit_w > TOTAL_WIDTH )) && fit_w=$TOTAL_WIDTH
                    (( fit_h > TOTAL_HEIGHT )) && fit_h=$TOTAL_HEIGHT
                    $IM_CMD "$image" -resize "${fit_w}x${fit_h}" "$center_fg"
                    $IM_CMD "$blur_bg" "$center_fg" -gravity center -composite -quality 95 "$CACHE_FILE"
                    rm -f "$blur_bg" "$center_fg"
                else
                    local fit_w fit_h
                    if (( img_w > img_h )); then
                        fit_w=$((TOTAL_WIDTH * 80 / 100))
                        fit_h=$((img_h * fit_w / img_w))
                    else
                        fit_h=$((TOTAL_HEIGHT * 80 / 100))
                        fit_w=$((img_w * fit_h / img_h))
                    fi
                    (( fit_w > TOTAL_WIDTH )) && fit_w=$TOTAL_WIDTH
                    (( fit_h > TOTAL_HEIGHT )) && fit_h=$TOTAL_HEIGHT
                    $IM_CMD "$image" -resize "${fit_w}x${fit_h}" -background "${CONFIG[color]}" -gravity center -extent "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" -quality 95 "$CACHE_FILE"
                fi
                ;;
            *) log "ERROR" "Unknown mode: $mode"; return 1 ;;
        esac
        [[ -f "$CACHE_FILE" ]] || { log "ERROR" "Image processing failed"; return 1; }
    else
        log "INFO" "Using cached image"
        touch "$CACHE_FILE"
    fi

    {
        echo "$image"
        echo "$mode"
        echo "${CONFIG[bg_type]}"
        if [[ "${CONFIG[bg_type]}" == "blur" ]]; then
            echo "${CONFIG[blur]}"
        else
            echo "${CONFIG[color]}"
        fi
        date '+%Y-%m-%d %H:%M:%S'
    } > "$STATE_FILE"

    case "${CONFIG[backend]}" in
        feh)
            feh --bg-scale "$CACHE_FILE" 2>/dev/null || log "WARN" "feh failed"
            ;;
        nitrogen)
            nitrogen --set-scaled "$CACHE_FILE" 2>/dev/null || log "WARN" "nitrogen failed"
            ;;
        *)
            gsettings set org.cinnamon.desktop.background picture-uri "file://$CACHE_FILE"
            gsettings set org.cinnamon.desktop.background picture-options "spanned"
            ;;
    esac
    log "INFO" "Wallpaper set successfully."
}

_create_background_canvas() {
    local first_image="$1"
    local canvas
    canvas="$(mktemp --suffix=.png)" || { log "ERROR" "Cannot create canvas"; return 1; }
    if [[ "${CONFIG[bg_type]}" == "blur" ]]; then
        $IM_CMD "$first_image" -resize "${TOTAL_WIDTH}x${TOTAL_HEIGHT}^" -gravity center -extent "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" -blur "0x${CONFIG[blur]}" "$canvas"
    else
        $IM_CMD -size "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" "xc:${CONFIG[color]}" "$canvas"
    fi
    echo "$canvas"
}

_process_monitor_images_parallel() {
    local mode="$1"; shift
    local -a imgs=("$@")
    local -a outfiles
    local -a pids
    local i

    for i in $(seq 0 $((MONITOR_COUNT-1))); do
        local outfile
        outfile="$(mktemp)" || { log "ERROR" "mktemp failed"; return 1; }
        process_image_for_area "${imgs[i]}" "${MONITOR_W[i]}" "${MONITOR_H[i]}" "${mode}" > "$outfile" &
        pids+=("$!")
        outfiles+=("$outfile")
    done
    wait "${pids[@]}"

    for i in $(seq 0 $((MONITOR_COUNT-1))); do
        local path_from_file
        path_from_file="$(cat "${outfiles[i]}")"
        if [[ -z "$path_from_file" ]] || [[ ! -f "$path_from_file" ]]; then
            log "ERROR" "Failed to process image for monitor $i"
            return 1
        fi
        outfiles[i]="$path_from_file"
    done

    printf '%s\n' "${outfiles[@]}"
}

_compose_per_monitor_canvas() {
    local mode="$1"; shift
    local canvas="$1"; shift
    local -a procs=("$@")
    local i

    for i in $(seq 0 $((MONITOR_COUNT-1))); do
        local proc="${procs[i]}"
        local mon_x="${MONITOR_X[i]}" mon_y="${MONITOR_Y[i]}"
        local mon_w="${MONITOR_W[i]}" mon_h="${MONITOR_H[i]}"
        local img_w img_h
        img_w="$($IM_IDENTIFY -format "%w" "$proc")"
        img_h="$($IM_IDENTIFY -format "%h" "$proc")"

        if [[ "$mode" == "zoom" ]]; then
            $IM_CMD "$canvas" "$proc" -geometry +"${mon_x}"+"${mon_y}" -composite "$canvas"
        else
            local offset_x=$(( mon_x + (mon_w - img_w) / 2 ))
            local offset_y=$(( mon_y + (mon_h - img_h) / 2 ))
            (( offset_x < mon_x )) && offset_x="$mon_x"
            (( offset_y < mon_y )) && offset_y="$mon_y"
            $IM_CMD "$canvas" "$proc" -geometry +"${offset_x}+${offset_y}" -composite "$canvas"
        fi
        rm -f "$proc"
    done
}

# ----------------------------------------------------------------------
# Per‑monitor wallpaper (parallel)
# ----------------------------------------------------------------------
set_per_monitor_wallpaper() {
    local images=("$@")
    local mode="${images[-1]}"
    case "$mode" in zoom|fit|center) unset 'images[-1]' ;; *) mode="${CONFIG[mode]}" ;; esac

    get_monitor_info
    if [[ ${#images[@]} -ne $MONITOR_COUNT ]]; then
        log "ERROR" "Provide exactly $MONITOR_COUNT image(s)."
        return 1
    fi
    for img in "${images[@]}"; do [[ -f "$img" ]] || { log "ERROR" "File not found: $img"; return 1; }; done

    log "INFO" "Setting per‑monitor wallpaper ($MONITOR_COUNT monitors)"
    get_total_span
    mkdir -p "$CACHE_DIR"

    local key_string="${mode}|${CONFIG[bg_type]}|${CONFIG[blur]}|${CONFIG[color]}|${TOTAL_WIDTH}x${TOTAL_HEIGHT}"
    for img in "${images[@]}"; do
        abs_img="$(readlink -f "$img")"
        safe_abs="$(safe_filename "$abs_img")"
        key_string="${key_string}|${safe_abs}|$(get_file_mtime "$abs_img")"
    done

    local cache_key
    cache_key="$(echo -n "$key_string" | md5sum | cut -d' ' -f1)"
    local CACHE_FILE="${CACHE_DIR}/${cache_key}.jpg"

    trim_cache

    if [[ ! -f "$CACHE_FILE" ]]; then
        log "INFO" "Processing per‑monitor images in parallel..."

        local bg_canvas
        bg_canvas="$(_create_background_canvas "${images[0]}")" || return 1

        local -a processed
        readarray -t processed < <(_process_monitor_images_parallel "$mode" "${images[@]}")
        _compose_per_monitor_canvas "$mode" "$bg_canvas" "${processed[@]}"

        $IM_CMD "$bg_canvas" -quality 95 "$CACHE_FILE"
        rm -f "$bg_canvas"
    else
        log "INFO" "Using cached per‑monitor image"
    fi

    local imgs_string
    imgs_string="$(printf "|%s" "${images[@]}")"
    imgs_string="${imgs_string:1}"
    {
        echo "per-monitor:$imgs_string"
        echo "$mode"
        echo "${CONFIG[bg_type]}"
        if [[ "${CONFIG[bg_type]}" == "blur" ]]; then echo "${CONFIG[blur]}"; else echo "${CONFIG[color]}"; fi
        date '+%Y-%m-%d %H:%M:%S'
    } > "$STATE_FILE"

    case "${CONFIG[backend]}" in
        feh) feh --bg-scale "$CACHE_FILE" ;;
        nitrogen) nitrogen --set-scaled "$CACHE_FILE" ;;
        *) gsettings set org.cinnamon.desktop.background picture-uri "file://$CACHE_FILE"
           gsettings set org.cinnamon.desktop.background picture-options "spanned" ;;
    esac
    log "INFO" "Per‑monitor wallpaper set."
}

# ----------------------------------------------------------------------
# Refresh and helper functions
# ----------------------------------------------------------------------
refresh_wallpaper() {
    if [[ ! -f "$STATE_FILE" ]]; then
        log "WARN" "No wallpaper state found; doing nothing."
        return 1
    fi

    local recent_line mode saved_bg_type saved_blur_or_color
    recent_line="$(head -n1 "$STATE_FILE")"
    mode="$(sed -n '2p' "$STATE_FILE" | head -n1)"
    saved_bg_type="$(sed -n '3p' "$STATE_FILE")"
    saved_blur_or_color="$(sed -n '4p' "$STATE_FILE")"

    [[ -z "$mode" ]] && mode="${CONFIG[mode]}"
    [[ -z "$saved_bg_type" ]] && saved_bg_type="${CONFIG[bg_type]}"

    # Save current global settings (we'll restore them later)
    local old_bg_type="${CONFIG[bg_type]}"
    local old_blur="${CONFIG[blur]}"
    local old_color="${CONFIG[color]}"

    # Temporarily apply the workspace’s saved settings
    CONFIG[bg_type]="$saved_bg_type"
    if [[ "$saved_bg_type" == "blur" ]]; then
        CONFIG[blur]="${saved_blur_or_color:-${CONFIG[blur]}}"
    else
        CONFIG[color]="${saved_blur_or_color:-${CONFIG[color]}}"
    fi

    if [[ "$recent_line" =~ ^per-monitor:(.*) ]]; then
        local pm_list="${BASH_REMATCH[1]}"
        local -a img_array
        IFS='|' read -ra img_array <<< "$pm_list"
        set_per_monitor_wallpaper "${img_array[@]}" "$mode"
    else
        local recent_image="$recent_line"
        if [[ -f "$recent_image" ]]; then
            set_wallpaper "$recent_image" "$mode" "true"
        else
            log "WARN" "Stored image not found; cannot refresh."
            CONFIG[bg_type]="$old_bg_type"
            CONFIG[blur]="$old_blur"
            CONFIG[color]="$old_color"
            return 1
        fi
    fi

    # Restore the original global settings
    CONFIG[bg_type]="$old_bg_type"
    CONFIG[blur]="$old_blur"
    CONFIG[color]="$old_color"
}

is_fullscreen_active() {
    local active_window
    active_window="$(xprop -root _NET_ACTIVE_WINDOW 2>/dev/null | awk '{print $5}')"
    [[ -n "$active_window" ]] || return 1
    xprop -id "$active_window" _NET_WM_STATE 2>/dev/null | grep -q "_NET_WM_STATE_FULLSCREEN"
}

# ----------------------------------------------------------------------
# Random rotation
# ----------------------------------------------------------------------
pick_random_image() {
    local dir="$1"
    local images=()
    while IFS= read -r -d $'\0' file; do
        images+=("$file")
    done < <(find "$dir" -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" \) -print0)
    if [[ ${#images[@]} -eq 0 ]]; then
        log "ERROR" "No images in $dir"
        return 1
    fi
    echo "${images[RANDOM % ${#images[@]}]}"
}

start_random_mode() {
    local directory="$1" mode="${2:-${CONFIG[mode]}}"
    local interval="${CONFIG[random_interval]}"
    [[ -d "$directory" ]] || { log "ERROR" "Directory not found: $directory"; return 1; }

    {
        echo "directory=$directory"
        echo "mode=$mode"
        echo "interval=$interval"
        echo "pid=$$"
    } > "$RANDOM_FILE"

    local first_image
    first_image="$(pick_random_image "$directory")" || return 1
    set_wallpaper "$first_image" "$mode"
    (
        local iterations=0
        while (( iterations < WATCHDOG_LIMIT )); do
            ((iterations++))
            sleep $((interval * 60))
            [[ -f "$RANDOM_FILE" ]] || exit 0
            local new_img
            new_img="$(pick_random_image "$directory")" || continue
            set_wallpaper "$new_img" "$mode"
        done
        log "ERROR" "Random rotation loop exceeded watchdog limit. Exiting."
    ) &
    echo $! >> "$RANDOM_FILE"
    log "INFO" "Random rotation started (PID $!)"
}

start_random_multi_mode() {
    local directory="$1" mode="${2:-${CONFIG[mode]}}"
    local interval="${CONFIG[random_interval]}"
    [[ -d "$directory" ]] || { log "ERROR" "Directory not found"; return 1; }
    get_monitor_info
    local N=$MONITOR_COUNT
    local images=()
    while IFS= read -r -d $'\0' file; do
        images+=("$file")
    done < <(find "$directory" -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" \) -print0)
    [[ ${#images[@]} -ge $N ]] || { log "ERROR" "Need at least $N images"; return 1; }

    {
        echo "directory=$directory"
        echo "mode=$mode"
        echo "interval=$interval"
        echo "pid=$$"
        echo "multi=true"
    } > "$RANDOM_FILE"

    pick_random_set() {
        local selected=() indices=()
        while [[ ${#indices[@]} -lt $N ]]; do
            local idx=$((RANDOM % ${#images[@]}))
            local already_present=false
            local existing
            for existing in "${indices[@]}"; do
                if [[ "$existing" == "$idx" ]]; then
                    already_present=true
                    break
                fi
            done
            if [[ "$already_present" == false ]]; then
                indices+=("$idx")
            fi
        done
        for idx in "${indices[@]}"; do selected+=("${images[$idx]}"); done
        printf '%s\n' "${selected[@]}"
    }

    local first_set
    readarray -t first_set < <(pick_random_set)
    set_per_monitor_wallpaper "${first_set[@]}" "$mode"

    (
        local iterations=0
        while (( iterations < WATCHDOG_LIMIT )); do
            ((iterations++))
            sleep $((interval * 60))
            [[ -f "$RANDOM_FILE" ]] || exit 0
            local new_set
            readarray -t new_set < <(pick_random_set)
            set_per_monitor_wallpaper "${new_set[@]}" "$mode"
        done
        log "ERROR" "Random multi rotation loop exceeded watchdog limit. Exiting."
    ) &
    echo $! >> "$RANDOM_FILE"
    log "INFO" "Random multi rotation started (PID $!)"
}

stop_random_mode() {
    if [[ -f "$RANDOM_FILE" ]]; then
        local pid
        pid="$(tail -n1 "$RANDOM_FILE")"
        kill "$pid" 2>/dev/null
        rm -f "$RANDOM_FILE"
        log "INFO" "Random rotation stopped."
    else
        log "WARN" "Random rotation not active."
    fi
}

# ----------------------------------------------------------------------
# Refresh daemon (with orphan cleanup)
# ----------------------------------------------------------------------
start_refresh_mode() {
    local interval="${1:-${CONFIG[refresh_interval]}}"
    [[ "$interval" =~ ^[0-9]+$ ]] || { log "ERROR" "Interval must be a number (minutes)"; return 1; }

    stop_refresh_mode   # ensure no stale processes
    sleep 0.5

    mkdir -p "$CONFIG_DIR"
    {
        echo "interval=$interval"
        echo "pid=$$"
    } > "$REFRESH_FILE"

    do_refresh() {
        local iterations=0
        while (( iterations < WATCHDOG_LIMIT )); do
            ((iterations++))
            sleep $((interval * 60))
            [[ -f "$REFRESH_FILE" ]] || exit 0
            log "INFO" "Auto-refreshing wallpaper"
            refresh_wallpaper
        done
        log "ERROR" "Refresh loop exceeded watchdog limit. Exiting."
    }

    do_refresh &
    local refresh_pid=$!
    echo $refresh_pid >> "$REFRESH_FILE"
    log "INFO" "Periodic refresh started (PID $refresh_pid)"

    if [[ "${CONFIG[fullscreen_pause]}" == "true" ]]; then
        monitor_fullscreen &
        echo $! > "$FULLSCREEN_FILE"
    fi

    if [[ ! -f "$LAYOUT_MONITOR_PIDFILE" ]] || ! kill -0 "$(cat "$LAYOUT_MONITOR_PIDFILE")" 2>/dev/null; then
        monitor_layout &
        echo $! > "$LAYOUT_MONITOR_PIDFILE"
    fi

    if [[ "${CONFIG[per_workspace]}" == "true" ]]; then
        monitor_workspace &
        echo $! >> "$LAYOUT_MONITOR_PIDFILE"   # reuse the same file or create a new one
    fi
}

stop_refresh_mode() {
    # Kill all refresh-related processes aggressively
    pkill -f "ultraspan.*refresh" 2>/dev/null || true
    pkill -f "ultraspan.*monitor_fullscreen" 2>/dev/null || true
    pkill -f "ultraspan.*monitor_layout" 2>/dev/null || true
    pkill -f "ultraspan.*monitor_workspace" 2>/dev/null || true
    rm -f "$REFRESH_FILE" "$FULLSCREEN_FILE"
    log "INFO" "Periodic refresh stopped."
}

# ----------------------------------------------------------------------
# Fullscreen & layout monitors
# ----------------------------------------------------------------------
monitor_fullscreen() {
    local was_fullscreen=false
    local iterations=0
    while (( iterations < WATCHDOG_LIMIT )); do
        ((iterations++))
        sleep 2
        if is_fullscreen_active; then
            if [[ "$was_fullscreen" == false ]]; then
                log "INFO" "Full‑screen detected – pausing services"
                local refresh_pid random_pid
                [[ -f "$REFRESH_FILE" ]] && refresh_pid="$(tail -n1 "$REFRESH_FILE")"
                [[ -f "$RANDOM_FILE" ]] && random_pid="$(tail -n1 "$RANDOM_FILE")"
                [[ -n "$refresh_pid" ]] && kill -STOP "$refresh_pid" 2>/dev/null
                [[ -n "$random_pid" ]] && kill -STOP "$random_pid" 2>/dev/null
                was_fullscreen=true
            fi
        else
            if [[ "$was_fullscreen" == true ]]; then
                log "INFO" "Full‑screen ended – resuming services"
                local refresh_pid random_pid
                [[ -f "$REFRESH_FILE" ]] && refresh_pid="$(tail -n1 "$REFRESH_FILE")"
                [[ -f "$RANDOM_FILE" ]] && random_pid="$(tail -n1 "$RANDOM_FILE")"
                [[ -n "$refresh_pid" ]] && kill -CONT "$refresh_pid" 2>/dev/null
                [[ -n "$random_pid" ]] && kill -CONT "$random_pid" 2>/dev/null
                was_fullscreen=false
            fi
        fi
    done
    log "ERROR" "Fullscreen monitor exceeded watchdog limit. Exiting."
}

monitor_layout() {
    local last_layout=""
    local iterations=0
    while (( iterations < WATCHDOG_LIMIT )); do
        ((iterations++))
        sleep 2
        local current_layout
        current_layout="$(xrandr --current --listmonitors 2>/dev/null | md5sum | cut -d' ' -f1)"
        if [[ -n "$last_layout" ]] && [[ "$current_layout" != "$last_layout" ]]; then
            log "INFO" "Display layout changed – reapplying wallpaper"
            refresh_wallpaper
        fi
        last_layout="$current_layout"
    done
    log "ERROR" "Layout monitor exceeded watchdog limit. Exiting."
}

# ----------------------------------------------------------------------
# Workspace change monitor (polling, reliable across Cinnamon versions)
# ----------------------------------------------------------------------
monitor_workspace() {
    sleep 2
    local last_ws=""
    local iterations=0
    while (( iterations < WATCHDOG_LIMIT )); do
        ((iterations++))
        load_config
        local new_ws
        new_ws="$(xdotool get_desktop 2>/dev/null || echo 0)"
        if [[ "$new_ws" != "$last_ws" ]]; then
            log "INFO" "Workspace changed to $new_ws"
            STATE_FILE="$(get_state_file "$new_ws")"
            refresh_wallpaper
            last_ws="$new_ws"
        fi
        sleep 1
    done
    log "ERROR" "Workspace monitor exceeded watchdog limit. Exiting."
}

# ----------------------------------------------------------------------
# Daemon with flags
# ----------------------------------------------------------------------
start_daemon() {
    local mode="${1:-background}"
    mkdir -p "$PID_DIR"

    # Ensure no other daemon is running
    if [[ -f "$DAEMON_PIDFILE" ]] && kill -0 "$(cat "$DAEMON_PIDFILE")" 2>/dev/null; then
        log "ERROR" "Daemon already running (PID $(cat "$DAEMON_PIDFILE"))."
        return 1
    fi

    acquire_lock
    # Stop any existing refresh/random to avoid duplicates
    stop_refresh_mode
    stop_random_mode
    release_lock

    log "INFO" "Starting ultraspan daemon (mode: $mode)..."

    # Start services inside a subshell for background mode,
    # or directly for foreground/oneshot.
    case "$mode" in
        foreground)
            echo "$$" > "$DAEMON_PIDFILE"
            start_refresh_mode "${CONFIG[refresh_interval]}"
            start_saved_random
            local iterations=0
            while (( iterations < WATCHDOG_LIMIT )); do
                ((iterations++))
                sleep 3600
            done
            log "ERROR" "Daemon idle loop exceeded watchdog limit. Exiting."
            ;;
        oneshot)
            echo "$$" > "$DAEMON_PIDFILE"
            start_refresh_mode "${CONFIG[refresh_interval]}"
            start_saved_random
            exit 0
            ;;
        *)
            # Background: fork a child that does all the work,
            # and the parent exits immediately.
            (
                echo "$BASHPID" > "$DAEMON_PIDFILE"
                start_refresh_mode "${CONFIG[refresh_interval]}"
                start_saved_random
                local iterations=0
                while (( iterations < WATCHDOG_LIMIT )); do
                    ((iterations++))
                    sleep 3600
                done
                log "ERROR" "Daemon idle loop exceeded watchdog limit. Exiting."
            ) &
            disown
            log "INFO" "Daemon sent to background."
            exit 0
            ;;
    esac
}

# Helper to start random if its state file exists
start_saved_random() {
    if [[ -f "$RANDOM_FILE" ]]; then
        local dir mode multi
        while IFS='=' read -r key value; do
            case "$key" in
                directory) dir="$value" ;;
                mode) mode="$value" ;;
                multi) multi="$value" ;;
            esac
        done < "$RANDOM_FILE"
        if [[ -n "$dir" ]]; then
            if [[ "$multi" == "true" ]]; then
                start_random_multi_mode "$dir" "$mode"
            else
                start_random_mode "$dir" "$mode"
            fi
        fi
    fi
}

# ----------------------------------------------------------------------
# Data Wipe
# ----------------------------------------------------------------------
data_wipe_ultraspan() {
    echo "This will remove ALL ultraspan configuration, cache, and state files."
    echo "Your wallpapers will be reset to the system default."
    read -r -p "Are you sure? (y/N) " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        echo "Aborted."
        return 0
    fi
    
    # Release lock before stopping daemon (we will remove the lock file later)
    release_lock 

    # Stop daemon and services first
    stop_daemon
    stop_refresh_mode
    stop_random_mode

    # Remove config, cache, PID dir, lock file
    rm -rf "$CONFIG_DIR" "$CACHE_DIR" "$PID_DIR" "$LOCK_FILE"

    # Reset wallpaper to default
    local default_wp="/usr/share/backgrounds/linuxmint/default_background.jpg"
    if [[ -f "$default_wp" ]]; then
        gsettings set org.cinnamon.desktop.background picture-uri "file://$default_wp"
    else
        gsettings reset org.cinnamon.desktop.background picture-uri
    fi
    gsettings set org.cinnamon.desktop.background picture-options "zoom"

    echo "All ultraspan data removed. You may now delete the script itself."
}

# ----------------------------------------------------------------------
# Stop daemon
# ----------------------------------------------------------------------
stop_daemon() {
    if [[ -f "$DAEMON_PIDFILE" ]]; then
        local pid
        pid="$(cat "$DAEMON_PIDFILE")"
        if kill -0 "$pid" 2>/dev/null; then
            kill -TERM "$pid" 2>/dev/null
            log "INFO" "Daemon stopped."
        fi
        rm -f "$DAEMON_PIDFILE"
    fi
    stop_refresh_mode
    stop_random_mode
}

# ----------------------------------------------------------------------
# Preview, list, diagnose, systemd, completions (unchanged)
# ----------------------------------------------------------------------
preview_wallpaper() {
    local image="$1" mode="${2:-${CONFIG[mode]}}"
    [[ -f "$image" ]] || { log "ERROR" "File not found: $image"; return 1; }
    get_total_span
    local scale="800"
    if [[ $TOTAL_WIDTH -gt $TOTAL_HEIGHT ]]; then
        scale_w=$scale
        scale_h=$((TOTAL_HEIGHT * scale / TOTAL_WIDTH))
    else
        scale_h=$scale
        scale_w=$((TOTAL_WIDTH * scale / TOTAL_HEIGHT))
    fi
    local temp_file
    temp_file="$(mktemp --suffix=.jpg)"
    $IM_CMD "$image" -resize "${scale_w}x${scale_h}" "$temp_file"
    echo "Preview saved to $temp_file"
    if command -v display &>/dev/null; then
        display "$temp_file"
    else
        xdg-open "$temp_file" 2>/dev/null || log "INFO" "Open $temp_file with your image viewer."
    fi
}

list_images() {
    local dir="$1"
    [[ -d "$dir" ]] || { log "ERROR" "Directory not found: $dir"; return 1; }
    printf "%-40s %8s %8s\n" "Filename" "Width" "Height"
    find "$dir" -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" \) -print0 | while IFS= read -r -d '' file; do
        local w h
        w="$($IM_IDENTIFY -format "%w" "$file" 2>/dev/null)" || w="?"
        h="$($IM_IDENTIFY -format "%h" "$file" 2>/dev/null)" || h="?"
        printf "%-40s %8s %8s\n" "$(basename "$file")" "$w" "$h"
    done
}

diagnose() {
    echo "=== Ultraspan Diagnose ==="
    echo "Version: $VERSION"
    echo "Bash: $BASH_VERSION"
    echo "ImageMagick: $($IM_CMD -version | head -1)"
    echo "Dependencies:"
    for cmd in xrandr gsettings md5sum bc feh nitrogen; do
        if command -v "$cmd" &>/dev/null; then
            echo "  ✅ $cmd"
        else
            echo "  ❌ $cmd (optional)"
        fi
    done
    echo "Config:"
    for k in "${!CONFIG[@]}"; do
        echo "  $k = ${CONFIG[$k]}"
    done
    echo "Monitor layout:"
    get_monitor_info
    echo "  Count: $MONITOR_COUNT"
    for i in $(seq 0 $((MONITOR_COUNT-1))); do
        echo "  ${MONITOR_NAMES[i]}: ${MONITOR_W[i]}x${MONITOR_H[i]} at ${MONITOR_X[i]},${MONITOR_Y[i]}"
    done
    echo "Cache: $(du -sh "$CACHE_DIR" 2>/dev/null | cut -f1)"
    echo "State file: $(head -n1 "$STATE_FILE" 2>/dev/null)"
    if [[ -f "$REFRESH_FILE" ]]; then
        echo "Refresh: active (PID $(tail -n1 "$REFRESH_FILE"))"
    else
        echo "Refresh: inactive"
    fi
    if [[ -f "$RANDOM_FILE" ]]; then
        echo "Random: active (PID $(tail -n1 "$RANDOM_FILE"))"
    else
        echo "Random: inactive"
    fi
    if [[ -f "$DAEMON_PIDFILE" ]] && kill -0 "$(cat "$DAEMON_PIDFILE")" 2>/dev/null; then
        echo "Daemon: running (PID $(cat "$DAEMON_PIDFILE"))"
    else
        echo "Daemon: not running"
    fi
}

generate_systemd() {
    cat <<EOF
[Unit]
Description=Ultraspan Wallpaper Daemon
After=graphical-session.target

[Service]
Type=forking
ExecStart=${BASH_SOURCE[0]} daemon
ExecStop=${BASH_SOURCE[0]} daemon-stop
Restart=on-failure
User=%i

[Install]
WantedBy=default.target
EOF
}

generate_completion() {
    cat <<'EOF'
_ultraspan() {
    local cur prev words cword
    _init_completion || return
    case $prev in
        set|set-per-monitor|random|random-multi|preview|info|list-images)
            _filedir
            return
            ;;
        mode|bg-type|blur|color|fullscreen|interval|backend)
            return
            ;;
    esac
    if [[ $cword -eq 1 ]]; then
        COMPREPLY=($(compgen -W "set set-per-monitor random random-multi random-stop random-status interval refresh-start refresh-stop refresh-status status info list-images preview diagnose daemon daemon-stop data-wipe set-config clean restore help --version" -- "$cur"))
    fi
}
complete -F _ultraspan ultraspan
EOF
}

