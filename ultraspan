# ----------------------------------------------------------------------
# Command handlers (split from main)
# ----------------------------------------------------------------------
_handle_set() {
    local workspace=""
    if [[ "$1" == "--workspace" ]]; then
        workspace="$2"; shift 2
    fi
    [[ -z "$1" ]] && { log "ERROR" "Usage: set [--workspace N] IMAGE [MODE] [force]"; return 1; }
    local mode="${2:-${CONFIG[mode]}}"
    local force="${3:-false}"
    if [[ -n "$workspace" ]]; then
        STATE_FILE="$(get_state_file "$workspace")"
    fi
    set_wallpaper "$1" "$mode" "$force"
    return $?
}

_handle_set_per_monitor() {
    local workspace=""
    if [[ "$1" == "--workspace" ]]; then
        workspace="$2"; shift 2
    fi
    [[ $# -eq 0 ]] && { log "ERROR" "Usage: set-per-monitor [--workspace N] IMG1 IMG2 ... [MODE]"; return 1; }
    if [[ -n "$workspace" ]]; then
        STATE_FILE="$(get_state_file "$workspace")"
    fi
    set_per_monitor_wallpaper "$@"
    return $?
}

_handle_random() {
    [[ -z "$1" ]] && { log "ERROR" "Usage: random DIR [MODE]"; return 1; }
    stop_random_mode
    start_random_mode "$1" "$2"
    return $?
}

_handle_random_multi() {
    [[ -z "$1" ]] && { log "ERROR" "Usage: random-multi DIR [MODE]"; return 1; }
    stop_random_mode
    start_random_multi_mode "$1" "$2"
    return $?
}

_handle_interval() {
    if [[ -z "$1" ]]; then
        echo "Interval: ${CONFIG[random_interval]} min"
        return 0
    fi
    [[ "$1" =~ ^[0-9]+$ ]] || { log "ERROR" "Invalid interval"; return 1; }
    update_config random_interval "$1" || return 1
    if [[ -f "$RANDOM_FILE" ]]; then
        local dir mode
        while IFS='=' read -r key value; do
            case "$key" in directory) dir="$value" ;; mode) mode="$value" ;; esac
        done < "$RANDOM_FILE"
        stop_random_mode
        [[ -n "$dir" ]] && start_random_mode "$dir" "$mode"
    fi
    return 0
}

_handle_refresh_start() {
    local interval="${1:-${CONFIG[refresh_interval]}}"
    start_refresh_mode "$interval"
    return $?
}

_handle_refresh_status() {
    if [[ -f "$REFRESH_FILE" ]]; then
        echo "Refresh interval: $(head -n1 "$REFRESH_FILE" | cut -d= -f2) min"
        echo "Active PIDs: $(tail -n +2 "$REFRESH_FILE")"
    else
        echo "Refresh not active."
    fi
    return 0
}

_handle_status() {
    echo "=== Ultraspan Status ==="
    echo "Version: $VERSION"
    if [[ "${CONFIG[backend]}" == "gsettings" ]]; then
        local current_uri
        current_uri="$(gsettings get org.cinnamon.desktop.background picture-uri 2>/dev/null | sed "s/'//g")"
        echo "Current wallpaper: $current_uri"
    else
        echo "Current wallpaper: (not using gsettings backend)"
    fi
    get_total_span || return 1
    echo "Span: ${TOTAL_WIDTH}x${TOTAL_HEIGHT}"
    echo "Mode: ${CONFIG[mode]}, Background: ${CONFIG[bg_type]}"
    [[ "${CONFIG[bg_type]}" == "blur" ]] && echo "Blur: ${CONFIG[blur]}" || echo "Color: ${CONFIG[color]}"
    echo "Backend: ${CONFIG[backend]}"
    echo "Cache limit: ${CONFIG[max_cache_mb]} MB"
    [[ -f "$RANDOM_FILE" ]] && echo "Random: active" || echo "Random: inactive"
    [[ -f "$REFRESH_FILE" ]] && echo "Refresh: active" || echo "Refresh: inactive"
    return 0
}

_handle_info() {
    [[ -z "$1" ]] && { log "ERROR" "Usage: info IMAGE"; return 1; }
    echo "File: $1"
    echo "Size: $(du -h "$1" | cut -f1)"
    local w h
    w="$($IM_IDENTIFY -format "%w" "$1" 2>/dev/null)" || w="?"
    h="$($IM_IDENTIFY -format "%h" "$1" 2>/dev/null)" || h="?"
    echo "Dimensions: ${w}x${h}"
    return 0
}

_handle_daemon() {
    local daemon_mode="background"
    if [[ "$1" == "--foreground" ]]; then
        daemon_mode="foreground"
    elif [[ "$1" == "--oneshot" ]]; then
        daemon_mode="oneshot"
    fi
    start_daemon "$daemon_mode"
    return $?
}

_handle_mode() {
    if [[ -z "$1" ]]; then
        echo "Mode: ${CONFIG[mode]}"
        return 0
    fi
    case "$1" in zoom|fit|center) ;; *) log "ERROR" "Invalid mode"; return 1 ;; esac
    update_config mode "$1" || return 1
    if [[ -f "$STATE_FILE" ]]; then
        local recent_image
        recent_image="$(head -n1 "$STATE_FILE")"
        [[ -f "$recent_image" ]] && set_wallpaper "$recent_image" "$1"
    fi
    return 0
}

_handle_bg_type() {
    if [[ -z "$1" ]]; then
        echo "Background type: ${CONFIG[bg_type]}"
        return 0
    fi
    case "$1" in blur|solid) ;; *) log "ERROR" "Invalid bg-type"; return 1 ;; esac
    update_config bg_type "$1" || return 1
    if [[ -f "$STATE_FILE" ]]; then
        local recent_image mode
        recent_image="$(head -n1 "$STATE_FILE")"
        mode="$(sed -n '2p' "$STATE_FILE" | head -n1)"
        [[ -f "$recent_image" ]] && set_wallpaper "$recent_image" "$mode"
    fi
    return 0
}

_handle_blur() {
    if [[ -z "$1" ]]; then
        echo "Blur: ${CONFIG[blur]}"
        return 0
    fi
    if ! [[ "$1" =~ ^[0-9]+$ ]] || ! [[ "$1" -ge 0 ]] || ! [[ "$1" -le 100 ]]; then
        log "ERROR" "Blur must be 0-100"
        return 1
    fi
    update_config blur "$1" || return 1
    if [[ -f "$STATE_FILE" ]] && [[ "${CONFIG[bg_type]}" == "blur" ]]; then
        local recent_image mode
        recent_image="$(head -n1 "$STATE_FILE")"
        mode="$(sed -n '2p' "$STATE_FILE" | head -n1)"
        [[ -f "$recent_image" ]] && set_wallpaper "$recent_image" "$mode"
    fi
    return 0
}

_handle_color() {
    if [[ -z "$1" ]]; then
        echo "Color: ${CONFIG[color]}"
        return 0
    fi
    local color="$1"
    color="${color#\#}"
    [[ "$color" =~ ^[0-9A-Fa-f]{6}$ ]] || { log "ERROR" "Invalid hex color"; return 1; }
    color="#$color"
    update_config color "$color" || return 1
    if [[ -f "$STATE_FILE" ]] && [[ "${CONFIG[bg_type]}" == "solid" ]]; then
        refresh_wallpaper
    fi
    return 0
}

_handle_fullscreen() {
    if [[ -z "$1" ]]; then
        echo "Fullscreen pause: ${CONFIG[fullscreen_pause]}"
        return 0
    fi
    local val
    case "$1" in on|true|1) val="true" ;; off|false|0) val="false" ;; *) log "ERROR" "Invalid value"; return 1 ;; esac
    update_config fullscreen_pause "$val" || return 1
    if [[ -f "$REFRESH_FILE" ]]; then
        local interval
        interval="$(head -n1 "$REFRESH_FILE" | cut -d= -f2)"
        stop_refresh_mode
        start_refresh_mode "$interval"
    fi
    return 0
}

_handle_backend() {
    if [[ -z "$1" ]]; then
        echo "Backend: ${CONFIG[backend]}"
        return 0
    fi
    case "$1" in gsettings|feh|nitrogen) ;; *) log "ERROR" "Invalid backend"; return 1 ;; esac
    update_config backend "$1" || return 1
    [[ -f "$STATE_FILE" ]] && refresh_wallpaper
    return 0
}

_handle_restore() {
    local default_wp="/usr/share/backgrounds/linuxmint/default_background.jpg"
    if [[ -f "$default_wp" ]]; then
        set_wallpaper "$default_wp" "zoom"
    else
        local alt
        alt="$(find /usr/share/backgrounds /usr/share/wallpapers -name "*.jpg" -o -name "*.png" | head -1)"
        if [[ -n "$alt" ]]; then
            set_wallpaper "$alt" "zoom"
        else
            log "ERROR" "No system wallpaper found"
            return 1
        fi
    fi
    return 0
}

# ----------------------------------------------------------------------
# Main dispatcher
# ----------------------------------------------------------------------
main() {
    # Ensure required directories exist
    mkdir -p "$CONFIG_DIR" "$CACHE_DIR" "$PID_DIR"

    load_config
    if [[ "${CONFIG[per_workspace]}" == "true" ]]; then
        STATE_FILE="$(get_state_file)"
    fi
    export MAGICK_MEMORY_LIMIT="${CONFIG[magick_memory]}"

    acquire_lock || return 1

    local cmd="${1:-help}"
    shift || true

    if (( $# == 0 )); then
        set -- ""
    fi

    local ret=0
    case "$cmd" in
        set) _handle_set "$@" ;;
        set-per-monitor) _handle_set_per_monitor "$@" ;;
        random) _handle_random "$@" ;;
        random-multi) _handle_random_multi "$@" ;;
        random-stop) stop_random_mode ;;
        random-status)
            if [[ -f "$RANDOM_FILE" ]]; then
                cat "$RANDOM_FILE"
            else
                echo "Random rotation not active."
            fi
            ;;
        interval) _handle_interval "$@" ;;
        refresh-start) _handle_refresh_start "$@" ;;
        refresh-stop) stop_refresh_mode ;;
        refresh-status) _handle_refresh_status ;;
        refresh-wallpaper) refresh_wallpaper ;;
        status) _handle_status ;;
        info) _handle_info "$@" ;;
        preview) [[ -z "$1" ]] && { log "ERROR" "Usage: preview IMAGE [MODE]"; ret=1; } || preview_wallpaper "$1" "$2";;
        list-images) [[ -z "$1" ]] && { log "ERROR" "Usage: list-images DIR"; ret=1; } || list_images "$1" ;;
        diagnose) diagnose ;;
        daemon) _handle_daemon "$@" ;;
        daemon-stop) stop_daemon ;;
        data-wipe) data_wipe_ultraspan ;;
        set-config)
            [[ -z "$1" ]] || [[ -z "$2" ]] && { log "ERROR" "Usage: set-config KEY VALUE"; ret=1; } || update_config "$1" "$2"
            ;;
        mode) _handle_mode "$@" ;;
        bg-type) _handle_bg_type "$@" ;;
        blur) _handle_blur "$@" ;;
        color) _handle_color "$@" ;;
        fullscreen) _handle_fullscreen "$@" ;;
        backend) _handle_backend "$@" ;;
        clean)
            log "INFO" "Cleaning cache..."
            rm -rf "$CACHE_DIR"
            mkdir -p "$CACHE_DIR"
            echo "Cache cleared."
            ;;
        restore) _handle_restore ;;
        generate-systemd) generate_systemd ;;
        generate-completion) generate_completion ;;
        help|--help|-h) show_help ;;
        --version) echo "Ultraspan version $VERSION" ;;
        *)
            log "ERROR" "Unknown command: $cmd"
            show_help
            ret=1
            ;;
    esac

    release_lock
    return $ret
}

# ----------------------------------------------------------------------
# Entry point
# ----------------------------------------------------------------------
main "$@"
