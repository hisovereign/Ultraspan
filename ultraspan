#!/bin/bash
set -u

# ============================================
# Ultraspan - Ultimate Multi-Monitor Wallpaper Utility
# ============================================
# Version 6.0.0
# ============================================

# ----------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------
declare -A CONFIG
CONFIG[mode]="zoom"
CONFIG[bg_type]="blur"
CONFIG[blur]=15
CONFIG[color]="#000000"
CONFIG[fullscreen_pause]="true"
CONFIG[random_interval]=30
CONFIG[refresh_interval]=480
CONFIG[multi_random]="false"
CONFIG[backend]="gsettings"
CONFIG[max_cache_mb]=2000
CONFIG[magick_memory]="2GiB"
CONFIG[config_version]=1
CONFIG[per_workspace]="false"
CONFIG[video_daemon]=""   # resolved at runtime by _find_video_daemon
CONFIG[video_slice_fps]=30
CONFIG[video_slice_crf]=18
CONFIG[fullscreen_grace_seconds]=5

VERSION="6.0.0"
CONFIG_DIR="${HOME}/.config/ultraspan"
CONFIG_FILE="${CONFIG_DIR}/config"
CACHE_DIR="${HOME}/.cache/ultraspan"
STATE_FILE="${CONFIG_DIR}/state"
RANDOM_FILE="${CONFIG_DIR}/random"
REFRESH_FILE="${CONFIG_DIR}/refresh"
LOCK_FILE="/tmp/ultraspan.lock"
FULLSCREEN_FILE="${CONFIG_DIR}/fullscreen"
LAYOUT_MONITOR_PIDFILE="${CONFIG_DIR}/layout_monitor.pid"
LOG_FILE="${CACHE_DIR}/ultraspan.log"
PID_DIR="/run/user/${UID}/ultraspan"
DAEMON_PIDFILE="${PID_DIR}/daemon.pid"
VIDEO_PID_FILE="${CONFIG_DIR}/video.pid"

DEBUG=false
VERBOSE=false
WATCHDOG_LIMIT=1000000

# Locate the lightning-bug daemon. Search order:
#   1. $ULTRASPAN_DAEMON env var (explicit override)
#   2. Next to this script (side-by-side install)
#   3. $HOME/.local/bin/lightning-bug (user install)
#   4. /usr/local/bin/lightning-bug (local system install)
#   5. /usr/bin/lightning-bug (distro install)
#   6. PATH lookup
_find_video_daemon() {
    if [[ -n "${ULTRASPAN_DAEMON:-}" && -x "$ULTRASPAN_DAEMON" ]]; then
        echo "$ULTRASPAN_DAEMON"
        return 0
    fi

    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

    local candidates=(
        "${script_dir}/lightning-bug"
        "${HOME}/.local/bin/lightning-bug"
        "/usr/local/bin/lightning-bug"
        "/usr/bin/lightning-bug"
    )
    for c in "${candidates[@]}"; do
        if [[ -x "$c" ]]; then
            echo "$c"
            return 0
        fi
    done

    local from_path
    from_path="$(command -v lightning-bug 2>/dev/null)"
    if [[ -n "$from_path" ]]; then
        echo "$from_path"
        return 0
    fi

    return 1
}

# ----------------------------------------------------------------------
# Assertion helpers
# ----------------------------------------------------------------------
assert_file_exists() {
    local file="$1"
    if [[ ! -f "$file" ]]; then
        log "ERROR" "Assertion failed: File not found: $file"
        return 1
    fi
    return 0
}

assert_dir_exists() {
    local dir="$1"
    if [[ ! -d "$dir" ]]; then
        log "ERROR" "Assertion failed: Directory not found: $dir"
        return 1
    fi
    return 0
}

assert_positive_int() {
    local val="$1"
    if [[ ! "$val" =~ ^[0-9]+$ ]] || [[ "$val" -le 0 ]]; then
        log "ERROR" "Assertion failed: Not a positive integer: $val"
        return 1
    fi
    return 0
}

assert_non_negative_int() {
    local val="$1"
    if [[ ! "$val" =~ ^[0-9]+$ ]]; then
        log "ERROR" "Assertion failed: Not a non-negative integer: $val"
        return 1
    fi
    return 0
}

assert_command_available() {
    local cmd="$1"
    if ! command -v "$cmd" >/dev/null 2>&1; then
        log "ERROR" "Assertion failed: Command not found: $cmd"
        return 1
    fi
    return 0
}

# ----------------------------------------------------------------------
# ImageMagick detection
# ----------------------------------------------------------------------
if command -v magick &>/dev/null; then
    IM_CMD="magick"
    IM_IDENTIFY="magick identify"
else
    IM_CMD="convert"
    IM_IDENTIFY="identify"
fi

# ----------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------
log() {
    local level="$1"; shift
    local msg="$*"
    local timestamp
    timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
    if [[ "$level" == "ERROR" ]]; then
        printf "[%s] %s: %s\n" "$timestamp" "$level" "$msg" >&2
    elif [[ "$DEBUG" == "true" ]] || [[ "$level" == "INFO" ]] || [[ "$level" == "WARN" ]]; then
        printf ... >> "$LOG_FILE"
    fi
    if [[ "$VERBOSE" == "true" ]] && [[ "$level" != "ERROR" ]]; then
        printf "[%s] %s\n" "$timestamp" "$msg"
    fi
}

debug_log() {
    [[ "$DEBUG" == "true" ]] && log "DEBUG" "$@"
    return 0
}

# ----------------------------------------------------------------------
# URL-encode a file path for gsettings
# ----------------------------------------------------------------------
url_encode() {
    local string="$1"
    local result=""
    local i c
    for ((i=0; i<${#string}; i++)); do
        c="${string:i:1}"
        case "$c" in
            [a-zA-Z0-9._~-]) result+="$c" ;;
            '/') result+='/' ;;
            *) result+="%$(printf '%02X' "'$c")" ;;
        esac
    done
    printf '%s' "$result"
}

# ----------------------------------------------------------------------
# Locking
# ----------------------------------------------------------------------
acquire_lock() {
    if [[ -f "$LOCK_FILE" ]]; then
        local lock_pid
        lock_pid="$(cat "$LOCK_FILE" 2>/dev/null)"
        if [[ -n "$lock_pid" ]] && ! kill -0 "$lock_pid" 2>/dev/null; then
            log "INFO" "Removing stale lock file (PID $lock_pid not alive)."
            rm -f "$LOCK_FILE"
        fi
    fi
    exec 9>"$LOCK_FILE" || { log "ERROR" "Cannot open lock file"; exit 1; }
    flock 9 || { log "ERROR" "Failed to acquire lock"; exit 1; }
    echo "$$" > "$LOCK_FILE"
    debug_log "Lock acquired (PID $$)."
}

release_lock() {
    flock -u 9 2>/dev/null
    exec 9>&-
    debug_log "Lock released."
}

cleanup() {
    release_lock
    if [[ -f "$DAEMON_PIDFILE" ]] && [[ "$(cat "$DAEMON_PIDFILE")" == "$$" ]]; then
        log "INFO" "Daemon cleaning up: killing children."
        pkill -P $$ 2>/dev/null
        rm -f "$DAEMON_PIDFILE"
    fi
    rm -f "$LAYOUT_MONITOR_PIDFILE"
}
trap cleanup EXIT

# ----------------------------------------------------------------------
# Config helpers
# ----------------------------------------------------------------------
migrate_config() {
    local current_version="${CONFIG[config_version]:-0}"
    if (( current_version < 1 )); then
        log "INFO" "Migrating config to version 1"
        CONFIG[max_cache_mb]=2000
        CONFIG[magick_memory]="2GiB"
        CONFIG[per_workspace]="false"
        CONFIG[config_version]=1
        update_config config_version 1
    fi
}

load_config() {
    if [[ -f "$CONFIG_FILE" ]]; then
        local key value
        while IFS='=' read -r key value; do
            key="${key## }"; key="${key%% }"
            value="${value## }"; value="${value%% }"
            if [[ -n "$key" ]] && [[ -n "$value" ]]; then
                CONFIG["$key"]="$value"
            fi
        done < "$CONFIG_FILE"
    fi
    : "${CONFIG[mode]:=zoom}"
    : "${CONFIG[bg_type]:=blur}"
    : "${CONFIG[blur]:=15}"
    : "${CONFIG[color]:=#000000}"
    : "${CONFIG[fullscreen_pause]:=true}"
    : "${CONFIG[random_interval]:=30}"
    : "${CONFIG[refresh_interval]:=480}"
    : "${CONFIG[multi_random]:=false}"
    : "${CONFIG[backend]:=gsettings}"
    : "${CONFIG[max_cache_mb]:=2000}"
    : "${CONFIG[magick_memory]:=2GiB}"
    : "${CONFIG[per_workspace]:=false}"
    : "${CONFIG[config_version]:=1}"
    : "${CONFIG[video_slice_fps]:=30}"
    : "${CONFIG[video_slice_crf]:=18}"
    : "${CONFIG[fullscreen_grace_seconds]:=5}"

    # Resolve daemon path if not set by config file or earlier.
    if [[ -z "${CONFIG[video_daemon]}" ]]; then
        local resolved
        if resolved="$(_find_video_daemon)"; then
            CONFIG[video_daemon]="$resolved"
        else
            log "WARN" "lightning-bug daemon not found. Video wallpaper commands will fail."
            log "WARN" "Searched: script dir, ~/.local/bin, /usr/local/bin, /usr/bin, PATH"
            log "WARN" "Set ULTRASPAN_DAEMON=/path/to/lightning-bug to override."
        fi
    fi

    migrate_config
}

update_config() {
    local key="$1" value="$2"
    [[ -n "$key" ]] || { log "ERROR" "Empty config key"; return 1; }
    CONFIG["$key"]="$value"
    local temp_file
    temp_file="$(mktemp)"
    for k in "${!CONFIG[@]}"; do
        printf "%s=%s\n" "$k" "${CONFIG[$k]}" >> "$temp_file"
    done
    mv "$temp_file" "$CONFIG_FILE"
    log "INFO" "Config updated: $key = $value"
}

# ----------------------------------------------------------------------
# Cache size management
# ----------------------------------------------------------------------
trim_cache() {
    local max_mb="${CONFIG[max_cache_mb]}"
    [[ "$max_mb" -eq 0 ]] && return
    local current_size
    current_size="$(du -sm "$CACHE_DIR" 2>/dev/null | cut -f1)"
    while [[ "$current_size" -gt "$max_mb" ]]; do
        local oldest
        oldest="$(find "$CACHE_DIR" -type f -printf '%T@ %p\n' | sort -n | head -1 | cut -d' ' -f2)"
        [[ -z "$oldest" ]] && break
        rm -f "$oldest"
        current_size="$(du -sm "$CACHE_DIR" 2>/dev/null | cut -f1)"
    done
}

# ----------------------------------------------------------------------
# Monitor geometry
# ----------------------------------------------------------------------
get_monitor_info() {
    unset MONITOR_NAMES MONITOR_X MONITOR_Y MONITOR_W MONITOR_H
    MIN_X=99999; MIN_Y=99999; MAX_X=0; MAX_Y=0
    local index=0
    while IFS= read -r line; do
        if [[ $line =~ ([0-9]+:[[:space:]]+[\+\*]*)([A-Za-z0-9-]+)[[:space:]]+([0-9]+)\/[0-9]+x([0-9]+)\/[0-9]+\+([0-9]+)\+([0-9]+) ]]; then
            MONITOR_NAMES[index]="${BASH_REMATCH[2]}"
            MONITOR_X[index]="${BASH_REMATCH[5]}"
            MONITOR_Y[index]="${BASH_REMATCH[6]}"
            MONITOR_W[index]="${BASH_REMATCH[3]}"
            MONITOR_H[index]="${BASH_REMATCH[4]}"
            (( MONITOR_X[index] < MIN_X )) && MIN_X=${MONITOR_X[index]}
            (( MONITOR_Y[index] < MIN_Y )) && MIN_Y=${MONITOR_Y[index]}
            local x2=$((MONITOR_X[index] + MONITOR_W[index]))
            local y2=$((MONITOR_Y[index] + MONITOR_H[index]))
            (( x2 > MAX_X )) && MAX_X=$x2
            (( y2 > MAX_Y )) && MAX_Y=$y2
            ((index++))
        fi
    done < <(xrandr --current --listmonitors 2>/dev/null)
    MONITOR_COUNT=$index
    if [[ $MONITOR_COUNT -eq 0 ]]; then
        log "ERROR" "No monitors detected. Cannot continue."
        return 1
    fi
    log "INFO" "Detected $MONITOR_COUNT monitors."
    return 0
}

# ----------------------------------------------------------------------
# Workspace helpers
# ----------------------------------------------------------------------
get_current_workspace() {
    assert_command_available xdotool || { echo 0; return 0; }
    xdotool get_desktop 2>/dev/null || echo 0
}

get_state_file() {
    local ws="${1:-$(get_current_workspace)}"
    assert_non_negative_int "$ws" || ws=0
    echo "${CONFIG_DIR}/state_workspace_${ws}"
}

get_total_span() {
    get_monitor_info || { log "ERROR" "Failed to get monitor info"; return 1; }
    TOTAL_WIDTH=$((MAX_X - MIN_X))
    TOTAL_HEIGHT=$((MAX_Y - MIN_Y))
    log "INFO" "Span: ${TOTAL_WIDTH}x${TOTAL_HEIGHT}"
    debug_log "Span: ${TOTAL_WIDTH}x${TOTAL_HEIGHT}"
    return 0
}

# ----------------------------------------------------------------------
# Filename safety
# ----------------------------------------------------------------------
safe_filename() {
    printf '%s\n' "${1//|/%PIPE%}"
}

# ----------------------------------------------------------------------
# Image/video helpers
# ----------------------------------------------------------------------
get_file_mtime() {
    stat -c %Y "$1" 2>/dev/null || echo "0"
}

_get_video_fps() {
    local file="$1"
    local raw
    raw="$(ffprobe -v error -select_streams v:0 \
        -show_entries stream=r_frame_rate \
        -of default=noprint_wrappers=1:nokey=1 "$file" 2>/dev/null)"
    if [[ -z "$raw" || "$raw" == "0/0" ]]; then
        echo 0
        return 0
    fi
    local num den
    if [[ "$raw" == */* ]]; then
        num="${raw%/*}"; den="${raw#*/}"
    else
        num="$raw"; den=1
    fi
    if [[ ! "$num" =~ ^[0-9]+$ ]] || [[ ! "$den" =~ ^[0-9]+$ ]] || (( den == 0 )); then
        echo 0
        return 0
    fi
    echo $(( num / den ))
}

process_image_for_area() {
    local image="$1" area_w="$2" area_h="$3" mode="$4"
    assert_file_exists "$image" || return 1
    assert_positive_int "$area_w" || return 1
    assert_positive_int "$area_h" || return 1

    local outfile
    outfile="$(mktemp)" || { log "ERROR" "Failed to create temp file"; return 1; }

    local img_w img_h
    img_w="$($IM_IDENTIFY -format "%w" "$image" 2>/dev/null)" || img_w=0
    img_h="$($IM_IDENTIFY -format "%h" "$image" 2>/dev/null)" || img_h=0

    case "$mode" in
        zoom)
            if [[ "$image" =~ \.(jpe?g)$ ]]; then
                $IM_CMD "$image" -define jpeg:size="${area_w}x${area_h}" \
                    -resize "${area_w}x${area_h}^" -gravity center -extent "${area_w}x${area_h}" "$outfile"
            else
                $IM_CMD "$image" -resize "${area_w}x${area_h}^" -gravity center -extent "${area_w}x${area_h}" "$outfile"
            fi
            ;;
        fit)
            $IM_CMD "$image" -resize "${area_w}x${area_h}" "$outfile"
            ;;
        center)
            local fit_w fit_h
            if (( img_w > img_h )); then
                fit_w=$(( area_w * 80 / 100 ))
                fit_h=$(( img_h * fit_w / img_w ))
            else
                fit_h=$(( area_h * 80 / 100 ))
                fit_w=$(( img_w * fit_h / img_h ))
            fi
            (( fit_w > area_w )) && fit_w=$area_w
            (( fit_h > area_h )) && fit_h=$area_h
            $IM_CMD "$image" -resize "${fit_w}x${fit_h}" "$outfile"
            ;;
        *) log "ERROR" "Unknown mode: $mode"; return 1 ;;
    esac
    echo "$outfile"
    return 0
}

# ----------------------------------------------------------------------
# Set wallpaper
# ----------------------------------------------------------------------
_build_wallpaper_cache() {
    local image="$1" mode="$2" force="$3"
    local abs_image mtime safe_abs key_string cache_key CACHE_FILE
    local img_w img_h

    abs_image="$(readlink -f "$image")"
    mtime="$(get_file_mtime "$abs_image")"
    safe_abs="$(safe_filename "$abs_image")"
    key_string="${safe_abs}|${mtime}|${mode}|${CONFIG[bg_type]}|${CONFIG[blur]}|${CONFIG[color]}|${TOTAL_WIDTH}x${TOTAL_HEIGHT}"
    cache_key="$(echo -n "$key_string" | md5sum | cut -d' ' -f1)"
    CACHE_FILE="${CACHE_DIR}/${cache_key}.jpg"
    log "INFO" "Cache file: $CACHE_FILE"

    trim_cache

    if [[ "$force" == "true" ]] || [[ ! -f "$CACHE_FILE" ]]; then
        log "INFO" "Processing image (cache miss or forced)..."
        img_w="$($IM_IDENTIFY -format "%w" "$image" 2>/dev/null)" || img_w=0
        img_h="$($IM_IDENTIFY -format "%h" "$image" 2>/dev/null)" || img_h=0
        debug_log "Original: ${img_w}x${img_h}"

        case "$mode" in
            zoom)
                if [[ "$image" =~ \.(jpe?g)$ ]]; then
                    $IM_CMD "$image" -define jpeg:size="${TOTAL_WIDTH}x${TOTAL_HEIGHT}" \
                        -resize "${TOTAL_WIDTH}x${TOTAL_HEIGHT}^" -gravity center -extent "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" -quality 95 "$CACHE_FILE"
                else
                    $IM_CMD "$image" -resize "${TOTAL_WIDTH}x${TOTAL_HEIGHT}^" -gravity center -extent "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" -quality 95 "$CACHE_FILE"
                fi
                ;;
            fit)
                if [[ "${CONFIG[bg_type]}" == "blur" ]]; then
                    $IM_CMD "$image" \
                        \( -clone 0 -resize "${TOTAL_WIDTH}x${TOTAL_HEIGHT}^" -gravity center -extent "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" -blur "0x${CONFIG[blur]}" \) \
                        \( -clone 0 -resize "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" \) \
                        -delete 0 -gravity center -composite -quality 95 "$CACHE_FILE"
                else
                    $IM_CMD "$image" -resize "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" -background "${CONFIG[color]}" -gravity center -extent "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" -quality 95 "$CACHE_FILE"
                fi
                ;;
            center)
                if [[ "${CONFIG[bg_type]}" == "blur" ]]; then
                    local blur_bg center_fg
                    blur_bg="$(mktemp)"; center_fg="$(mktemp)"
                    $IM_CMD "$image" -resize "${TOTAL_WIDTH}x${TOTAL_HEIGHT}^" -gravity center -extent "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" -blur "0x${CONFIG[blur]}" "$blur_bg"
                    local fit_w fit_h
                    if (( img_w > img_h )); then
                        fit_w=$((TOTAL_WIDTH * 80 / 100))
                        fit_h=$((img_h * fit_w / img_w))
                    else
                        fit_h=$((TOTAL_HEIGHT * 80 / 100))
                        fit_w=$((img_w * fit_h / img_h))
                    fi
                    (( fit_w > TOTAL_WIDTH )) && fit_w=$TOTAL_WIDTH
                    (( fit_h > TOTAL_HEIGHT )) && fit_h=$TOTAL_HEIGHT
                    $IM_CMD "$image" -resize "${fit_w}x${fit_h}" "$center_fg"
                    $IM_CMD "$blur_bg" "$center_fg" -gravity center -composite -quality 95 "$CACHE_FILE"
                    rm -f "$blur_bg" "$center_fg"
                else
                    local fit_w fit_h
                    if (( img_w > img_h )); then
                        fit_w=$((TOTAL_WIDTH * 80 / 100))
                        fit_h=$((img_h * fit_w / img_w))
                    else
                        fit_h=$((TOTAL_HEIGHT * 80 / 100))
                        fit_w=$((img_w * fit_h / img_h))
                    fi
                    (( fit_w > TOTAL_WIDTH )) && fit_w=$TOTAL_WIDTH
                    (( fit_h > TOTAL_HEIGHT )) && fit_h=$TOTAL_HEIGHT
                    $IM_CMD "$image" -resize "${fit_w}x${fit_h}" -background "${CONFIG[color]}" -gravity center -extent "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" -quality 95 "$CACHE_FILE"
                fi
                ;;
            *) log "ERROR" "Unknown mode: $mode"; return 1 ;;
        esac
        if [[ ! -f "$CACHE_FILE" ]]; then
            log "ERROR" "Image processing failed: $CACHE_FILE not created."
            return 1
        fi
        log "INFO" "Cache file created successfully."
    else
        log "INFO" "Using cached image"
        touch "$CACHE_FILE"
    fi
    echo "$CACHE_FILE"
    return 0
}

_save_wallpaper_state() {
    local image="$1" mode="$2"
    {
        echo "$image"
        echo "$mode"
        echo "${CONFIG[bg_type]}"
        if [[ "${CONFIG[bg_type]}" == "blur" ]]; then
            echo "${CONFIG[blur]}"
        else
            echo "${CONFIG[color]}"
        fi
        date '+%Y-%m-%d %H:%M:%S'
    } > "$STATE_FILE"
    log "INFO" "State saved to $STATE_FILE"
    return 0
}

_apply_wallpaper_backend() {
    local cache_file="$1"
    assert_file_exists "$cache_file" || return 1

    local backend="${CONFIG[backend]}"
    log "INFO" "Applying wallpaper with backend: $backend, file: $cache_file"

    case "$backend" in
        feh)
            feh --bg-scale "$cache_file" 2>/dev/null || { log "WARN" "feh failed"; return 1; }
            ;;
        nitrogen)
            nitrogen --set-scaled "$cache_file" 2>/dev/null || { log "WARN" "nitrogen failed"; return 1; }
            ;;
        *)
            local encoded_path
            encoded_path="$(url_encode "$cache_file")"
            local uri="file://$encoded_path"
            log "INFO" "gsettings URI: $uri"
            gsettings set org.cinnamon.desktop.background picture-uri "$uri" || {
                log "ERROR" "gsettings picture-uri failed"
                return 1
            }
            gsettings set org.cinnamon.desktop.background picture-options "spanned" || {
                log "ERROR" "gsettings picture-options failed"
                return 1
            }
            ;;
    esac
    log "INFO" "Wallpaper applied successfully."
    return 0
}

set_wallpaper() {
    local image="$1" mode="${2:-${CONFIG[mode]}}" force="${3:-false}"
    local cache_file

    log "INFO" "set_wallpaper called with image: $image, mode: $mode, force: $force"
    assert_file_exists "$image" || return 1
    get_total_span || return 1

    mkdir -p "$CACHE_DIR" "$CONFIG_DIR"

    cache_file="$(_build_wallpaper_cache "$image" "$mode" "$force")" || return 1
    _save_wallpaper_state "$image" "$mode" || return 1
    _apply_wallpaper_backend "$cache_file" || return 1

    log "INFO" "Wallpaper set successfully."
    return 0
}

# ----------------------------------------------------------------------
# Per-monitor wallpaper
# ----------------------------------------------------------------------
_create_background_canvas() {
    local first_image="$1"
    local canvas
    canvas="$(mktemp --suffix=.png)" || { log "ERROR" "Cannot create canvas"; return 1; }
    if [[ "${CONFIG[bg_type]}" == "blur" ]]; then
        $IM_CMD "$first_image" -resize "${TOTAL_WIDTH}x${TOTAL_HEIGHT}^" -gravity center -extent "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" -blur "0x${CONFIG[blur]}" "$canvas"
    else
        $IM_CMD -size "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" "xc:${CONFIG[color]}" "$canvas"
    fi
    echo "$canvas"
    return 0
}

_process_monitor_images_parallel() {
    local mode="$1"; shift
    local -a imgs=("$@")
    local -a outfiles
    local -a pids
    local i

    for i in $(seq 0 $((MONITOR_COUNT-1))); do
        local outfile
        outfile="$(mktemp)" || { log "ERROR" "mktemp failed"; return 1; }
        process_image_for_area "${imgs[i]}" "${MONITOR_W[i]}" "${MONITOR_H[i]}" "${mode}" > "$outfile" &
        pids+=("$!")
        outfiles+=("$outfile")
    done
    wait "${pids[@]}"

    for i in $(seq 0 $((MONITOR_COUNT-1))); do
        local temp_file="${outfiles[i]}"
        local path_from_file
        path_from_file="$(cat "$temp_file")"
        if [[ -z "$path_from_file" ]] || [[ ! -f "$path_from_file" ]]; then
            log "ERROR" "Failed to process image for monitor $i"
            for f in "${outfiles[@]}"; do [[ -f "$f" ]] && rm -f "$f"; done
            return 1
        fi
        rm -f "$temp_file"
        outfiles[i]="$path_from_file"
    done

    printf '%s\n' "${outfiles[@]}"
    return 0
}

_compose_per_monitor_canvas() {
    local mode="$1"; shift
    local canvas="$1"; shift
    local -a procs=("$@")
    local i

    for i in $(seq 0 $((MONITOR_COUNT-1))); do
        local proc="${procs[i]}"
        local mon_x="${MONITOR_X[i]}" mon_y="${MONITOR_Y[i]}"
        local mon_w="${MONITOR_W[i]}" mon_h="${MONITOR_H[i]}"
        local img_w img_h
        img_w="$($IM_IDENTIFY -format "%w" "$proc")"
        img_h="$($IM_IDENTIFY -format "%h" "$proc")"

        if [[ "$mode" == "zoom" ]]; then
            $IM_CMD "$canvas" "$proc" -gravity NorthWest -geometry +"${mon_x}"+"${mon_y}" -composite "$canvas"
        else
            local offset_x=$(( mon_x + (mon_w - img_w) / 2 ))
            local offset_y=$(( mon_y + (mon_h - img_h) / 2 ))
            (( offset_x < mon_x )) && offset_x="$mon_x"
            (( offset_y < mon_y )) && offset_y="$mon_y"
            $IM_CMD "$canvas" "$proc" -gravity NorthWest -geometry +"${offset_x}+${offset_y}" -composite "$canvas"
        fi
        rm -f "$proc"
    done
    return 0
}

_compute_per_monitor_cache_key() {
    local mode="$1"; shift
    local -a imgs=("$@")
    local key_string="${mode}|${CONFIG[bg_type]}|${CONFIG[blur]}|${CONFIG[color]}|${TOTAL_WIDTH}x${TOTAL_HEIGHT}"
    for img in "${imgs[@]}"; do
        local abs_img safe_abs
        abs_img="$(readlink -f "$img")"
        safe_abs="$(safe_filename "$abs_img")"
        key_string="${key_string}|${safe_abs}|$(get_file_mtime "$abs_img")"
    done
    local cache_key
    cache_key="$(echo -n "$key_string" | md5sum | cut -d' ' -f1)"
    echo "$cache_key"
    return 0
}

_generate_per_monitor_wallpaper() {
    local mode="$1"
    local cache_file="$2"
    shift 2
    local -a imgs=("$@")
    local bg_canvas
    local -a processed

    bg_canvas="$(_create_background_canvas "${imgs[0]}")" || return 1
    readarray -t processed < <(_process_monitor_images_parallel "$mode" "${imgs[@]}") || return 1
    _compose_per_monitor_canvas "$mode" "$bg_canvas" "${processed[@]}" || return 1

    $IM_CMD "$bg_canvas" -quality 95 "$cache_file" || { log "ERROR" "Failed to write final image"; return 1; }
    rm -f "$bg_canvas"
    return 0
}

_save_per_monitor_state() {
    local mode="$1"; shift
    local -a imgs=("$@")
    local imgs_string
    imgs_string="$(printf "|%s" "${imgs[@]}")"
    imgs_string="${imgs_string:1}"
    {
        echo "per-monitor:$imgs_string"
        echo "$mode"
        echo "${CONFIG[bg_type]}"
        if [[ "${CONFIG[bg_type]}" == "blur" ]]; then echo "${CONFIG[blur]}"; else echo "${CONFIG[color]}"; fi
        date '+%Y-%m-%d %H:%M:%S'
    } > "$STATE_FILE"
    return 0
}

_apply_per_monitor_backend() {
    local cache_file="$1"
    assert_file_exists "$cache_file" || return 1

    local backend="${CONFIG[backend]}"
    log "INFO" "Applying per-monitor wallpaper with backend: $backend"
    case "$backend" in
        feh) feh --bg-scale "$cache_file" ;;
        nitrogen) nitrogen --set-scaled "$cache_file" ;;
        *)
            local encoded_path
            encoded_path="$(url_encode "$cache_file")"
            local uri="file://$encoded_path"
            gsettings set org.cinnamon.desktop.background picture-uri "$uri" || return 1
            gsettings set org.cinnamon.desktop.background picture-options "spanned" || return 1
            ;;
    esac
    return 0
}

set_per_monitor_wallpaper() {
    local images=("$@")
    local mode="${images[-1]}"
    local cache_key CACHE_FILE

    case "$mode" in zoom|fit|center) unset 'images[-1]' ;; *) mode="${CONFIG[mode]}" ;; esac

    get_monitor_info || return 1
    if [[ ${#images[@]} -ne $MONITOR_COUNT ]]; then
        log "ERROR" "Provide exactly $MONITOR_COUNT image(s)."
        return 1
    fi
    for img in "${images[@]}"; do
        assert_file_exists "$img" || return 1
    done

    log "INFO" "Setting per-monitor wallpaper ($MONITOR_COUNT monitors)"
    get_total_span || return 1
    mkdir -p "$CACHE_DIR"

    cache_key="$(_compute_per_monitor_cache_key "$mode" "${images[@]}")" || return 1
    CACHE_FILE="${CACHE_DIR}/${cache_key}.jpg"
    trim_cache

    if [[ ! -f "$CACHE_FILE" ]]; then
        log "INFO" "Processing per-monitor images..."
        _generate_per_monitor_wallpaper "$mode" "$CACHE_FILE" "${images[@]}" || return 1
    else
        log "INFO" "Using cached per-monitor image"
    fi

    _save_per_monitor_state "$mode" "${images[@]}" || return 1
    _apply_per_monitor_backend "$CACHE_FILE" || return 1
    log "INFO" "Per-monitor wallpaper set."
    return 0
}

# ----------------------------------------------------------------------
# Video wallpaper (Rust daemon)
# ----------------------------------------------------------------------
set_video_wallpaper() {
    local video_file="$1"
    assert_file_exists "$video_file" || return 1

    stop_video_wallpaper
    _ensure_fullscreen_monitor

    local daemon="${CONFIG[video_daemon]}"
    assert_file_exists "$daemon" || { log "ERROR" "Video daemon not found: $daemon"; return 1; }

    log "INFO" "Starting video daemon in split mode"
    "$daemon" --split "$video_file" >/dev/null 2>&1 &
    local pid=$!
    disown

    echo "$pid" > "$VIDEO_PID_FILE"
    log "INFO" "Video wallpaper started (PID $pid)"
    return 0
}

set_video_per_monitor_wallpaper() {
    if [[ $# -eq 0 ]]; then
        log "ERROR" "Usage: set-video-per-monitor VIDEO1 VIDEO2 ... VIDEO_N"
        return 1
    fi

    local daemon="${CONFIG[video_daemon]}"
    assert_file_exists "$daemon" || { log "ERROR" "Video daemon not found: $daemon"; return 1; }

    local f
    for f in "$@"; do
        assert_file_exists "$f" || return 1
    done

    stop_video_wallpaper
    _ensure_fullscreen_monitor

    log "INFO" "Starting video daemon in per-monitor mode with $# video(s)"
    "$daemon" --per-monitor "$@" >/dev/null 2>&1 &
    local pid=$!
    disown

    echo "$pid" > "$VIDEO_PID_FILE"
    log "INFO" "Per-monitor video wallpaper started (PID $pid)"
    return 0
}

set_video_span_wallpaper() {
    local video_file="$1"
    assert_file_exists "$video_file" || return 1
    get_monitor_info || return 1
    get_total_span || return 1

    stop_video_wallpaper
    _ensure_fullscreen_monitor

    assert_command_available ffmpeg || return 1
    assert_command_available ffprobe || return 1

    local abs_video
    abs_video="$(readlink -f "$video_file")"
    local mtime
    mtime="$(get_file_mtime "$abs_video")"

    local target_fps="${CONFIG[video_slice_fps]}"
    local crf="${CONFIG[video_slice_crf]}"
    if [[ ! "$target_fps" =~ ^[0-9]+$ ]] || (( target_fps <= 0 )); then
        log "WARN" "Invalid video_slice_fps='${CONFIG[video_slice_fps]}', using 30"
        target_fps=30
    fi
    if [[ ! "$crf" =~ ^[0-9]+$ ]] || (( crf < 0 || crf > 51 )); then
        log "WARN" "Invalid video_slice_crf='${CONFIG[video_slice_crf]}', using 18"
        crf=18
    fi

    local src_fps actual_fps
    src_fps="$(_get_video_fps "$abs_video")"
    if (( src_fps > 0 && src_fps < target_fps )); then
        actual_fps="$src_fps"
        log "INFO" "Source ${src_fps}fps < target ${target_fps}fps; keeping ${actual_fps}fps"
    else
        actual_fps="$target_fps"
        log "INFO" "Target fps: ${actual_fps} (source: ${src_fps:-unknown})"
    fi

    local key_string="vspan2|${abs_video}|${mtime}|${TOTAL_WIDTH}x${TOTAL_HEIGHT}|fps=${actual_fps}|crf=${crf}"
    local i
    for i in $(seq 0 $((MONITOR_COUNT-1))); do
        key_string+="|${MONITOR_W[i]}x${MONITOR_H[i]}+${MONITOR_X[i]}+${MONITOR_Y[i]}"
    done
    local cache_key
    cache_key="$(echo -n "$key_string" | md5sum | cut -d' ' -f1)"
    local split_dir="${CACHE_DIR}/vspan_${cache_key}"
    mkdir -p "$split_dir"

    log "INFO" "Span ${TOTAL_WIDTH}x${TOTAL_HEIGHT}, ${MONITOR_COUNT} monitors, ${actual_fps}fps crf=${crf}"
    log "INFO" "Slice cache: $split_dir"

    local files=()
    for i in $(seq 0 $((MONITOR_COUNT-1))); do
        local out="${split_dir}/mon_${i}.mp4"
        files+=("$out")

        if [[ -f "$out" ]] && [[ "$out" -nt "$abs_video" ]]; then
            log "INFO" "Monitor $i slice cached"
            continue
        fi

        local mon_x="${MONITOR_X[i]}" mon_y="${MONITOR_Y[i]}"
        local mon_w="${MONITOR_W[i]}" mon_h="${MONITOR_H[i]}"
        local rel_x=$(( mon_x - MIN_X ))
        local rel_y=$(( mon_y - MIN_Y ))
        (( rel_x < 0 )) && rel_x=0
        (( rel_y < 0 )) && rel_y=0

        local vf="scale=${TOTAL_WIDTH}:${TOTAL_HEIGHT}:force_original_aspect_ratio=increase"
        vf+=",crop=${TOTAL_WIDTH}:${TOTAL_HEIGHT}:(iw-${TOTAL_WIDTH})/2:(ih-${TOTAL_HEIGHT})/2"
        vf+=",crop=${mon_w}:${mon_h}:${rel_x}:${rel_y}"
        vf+=",fps=${actual_fps}"

        log "INFO" "Cutting monitor $i: ${mon_w}x${mon_h}+${rel_x}+${rel_y} @ ${actual_fps}fps"
        if ! ffmpeg -y -loglevel error -i "$abs_video" \
                -vf "$vf" -an \
                -c:v libx264 -crf "$crf" -preset medium \
                "$out"; then
            log "ERROR" "ffmpeg failed on monitor $i"
            rm -f "$out"
            return 1
        fi
    done

    local daemon="${CONFIG[video_daemon]}"
    assert_file_exists "$daemon" || { log "ERROR" "Daemon not found: $daemon"; return 1; }

    log "INFO" "Launching ${#files[@]} slice(s) via daemon --per-monitor"
    "$daemon" --per-monitor "${files[@]}" >/dev/null 2>&1 &
    local pid=$!
    disown
    echo "$pid" > "$VIDEO_PID_FILE"
    log "INFO" "Spanning video (pre-cut) started (PID $pid)"
    return 0
}

set_video_on_wallpaper() {
    if [[ $# -eq 0 ]]; then
        log "ERROR" "Usage: set-video-on IDX:VIDEO [IDX:VIDEO ...]"
        log "ERROR" "Example: set-video-on 0:~/a.mp4 2:~/b.mp4"
        return 1
    fi

    local daemon="${CONFIG[video_daemon]}"
    assert_file_exists "$daemon" || { log "ERROR" "Video daemon not found: $daemon"; return 1; }

    get_monitor_info || return 1

    local -a on_args=()
    local pair idx path
    for pair in "$@"; do
        if [[ ! "$pair" =~ ^([0-9]+):(.+)$ ]]; then
            log "ERROR" "Invalid argument (expected IDX:VIDEO): $pair"
            return 1
        fi
        idx="${BASH_REMATCH[1]}"
        path="${BASH_REMATCH[2]}"

        if [[ "$path" == "~"* ]]; then
            path="${HOME}${path:1}"
        fi

        if (( idx >= MONITOR_COUNT )); then
            log "ERROR" "Monitor index $idx out of range (0..$((MONITOR_COUNT-1)))"
            return 1
        fi
        assert_file_exists "$path" || return 1
        on_args+=("${idx}:${path}")
    done

    stop_video_wallpaper
    _ensure_fullscreen_monitor

    log "INFO" "Starting daemon with --on ${on_args[*]}"
    "$daemon" --on "${on_args[@]}" >/dev/null 2>&1 &
    local pid=$!
    disown
    echo "$pid" > "$VIDEO_PID_FILE"
    log "INFO" "Video(s) on selected monitors started (PID $pid)"
    return 0
}

stop_video_wallpaper() {
    if [[ -f "$VIDEO_PID_FILE" ]]; then
        local pid
        pid="$(cat "$VIDEO_PID_FILE")"
        if kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null || true
            pkill -P "$pid" 2>/dev/null || true
        fi
        rm -f "$VIDEO_PID_FILE"
        log "INFO" "Video wallpaper stopped."
    fi
    return 0
}

pause_video_wallpaper() {
    if [[ ! -f "$VIDEO_PID_FILE" ]]; then
        log "WARN" "No video wallpaper running."
        return 1
    fi
    local pid
    pid="$(cat "$VIDEO_PID_FILE")"
    if kill -0 "$pid" 2>/dev/null; then
        kill -USR1 "$pid" 2>/dev/null
        log "INFO" "Video wallpaper paused."
        return 0
    fi
    log "WARN" "Video wallpaper not running (stale pid file)."
    return 1
}

resume_video_wallpaper() {
    if [[ ! -f "$VIDEO_PID_FILE" ]]; then
        log "WARN" "No video wallpaper running."
        return 1
    fi
    local pid
    pid="$(cat "$VIDEO_PID_FILE")"
    if kill -0 "$pid" 2>/dev/null; then
        kill -USR2 "$pid" 2>/dev/null
        log "INFO" "Video wallpaper resumed."
        return 0
    fi
    log "WARN" "Video wallpaper not running (stale pid file)."
    return 1
}

# ----------------------------------------------------------------------
# Mixed media: images and videos per monitor
# ----------------------------------------------------------------------
_is_video_media() {
    local file="$1"
    case "$file" in
        *.mp4|*.mkv|*.avi|*.mov|*.webm|*.gif|*.MP4|*.MKV|*.AVI|*.MOV|*.WEBM)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

_build_mixed_canvas() {
    local cache_file="$1"
    shift
    local -a entries=("$@")
    local mode="${CONFIG[mode]}"
    local i

    local first_static=""
    for i in $(seq 0 $((MONITOR_COUNT-1))); do
        local e="${entries[i]}"
        if [[ "$e" != "none" ]] && ! _is_video_media "$e"; then
            first_static="$e"
            break
        fi
    done

    local bg_canvas
    if [[ -z "$first_static" ]]; then
        bg_canvas="$(mktemp --suffix=.png)" || return 1
        $IM_CMD -size "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" "xc:${CONFIG[color]}" "$bg_canvas" || {
            rm -f "$bg_canvas"; return 1
        }
    else
        bg_canvas="$(_create_background_canvas "$first_static")" || return 1
    fi

    for i in $(seq 0 $((MONITOR_COUNT-1))); do
        local e="${entries[i]}"
        if [[ "$e" == "none" ]] || _is_video_media "$e"; then
            continue
        fi
        local proc_file
        local proc_file
        proc_file="$(process_image_for_area "$e" "${MONITOR_W[i]}" "${MONITOR_H[i]}" "$mode")" || {
            rm -f "$bg_canvas"
            return 1
        }
        local img_w img_h
        img_w="$($IM_IDENTIFY -format "%w" "$proc_file")"
        img_h="$($IM_IDENTIFY -format "%h" "$proc_file")"

        local mon_x="${MONITOR_X[i]}"
        local mon_y="${MONITOR_Y[i]}"
        local mon_w="${MONITOR_W[i]}"
        local mon_h="${MONITOR_H[i]}"

        if [[ "$mode" == "zoom" ]]; then
            $IM_CMD "$bg_canvas" "$proc_file" -gravity NorthWest \
                -geometry +"${mon_x}"+"${mon_y}" \
                -composite "$bg_canvas" || {
                rm -f "$bg_canvas" "$proc_file"
                return 1
            }
        else
            local offset_x=$(( mon_x + (mon_w - img_w) / 2 ))
            local offset_y=$(( mon_y + (mon_h - img_h) / 2 ))
            (( offset_x < mon_x )) && offset_x="$mon_x"
            (( offset_y < mon_y )) && offset_y="$mon_y"
            $IM_CMD "$bg_canvas" "$proc_file" -gravity NorthWest \
                -geometry +"${offset_x}"+"${offset_y}" \
                -composite "$bg_canvas" || {
                rm -f "$bg_canvas" "$proc_file"
                return 1
            }
        fi
        rm -f "$proc_file"
    done

    $IM_CMD "$bg_canvas" -quality 95 "$cache_file" || {
        rm -f "$bg_canvas"
        return 1
    }
    rm -f "$bg_canvas"
    return 0
}

set_mixed_media_wallpaper() {
    local entries=("$@")
    get_monitor_info || return 1

    if [[ ${#entries[@]} -ne $MONITOR_COUNT ]]; then
        log "ERROR" "Provide exactly $MONITOR_COUNT entries (image, video, or \"none\")."
        return 1
    fi

    local -a video_indices=()
    local -a video_paths=()
    local i
    for i in $(seq 0 $((MONITOR_COUNT-1))); do
        local e="${entries[i]}"
        if [[ "$e" == "none" ]]; then
            continue
        fi
        if [[ ! -f "$e" ]]; then
            log "ERROR" "File not found: $e"
            return 1
        fi
        if _is_video_media "$e"; then
            video_indices+=("$i")
            video_paths+=("$e")
        fi
    done

    stop_video_wallpaper
    _ensure_fullscreen_monitor

    local daemon="${CONFIG[video_daemon]}"
    assert_file_exists "$daemon" || { log "ERROR" "Video daemon not found: $daemon"; return 1; }

    if [[ ${#video_indices[@]} -eq $MONITOR_COUNT ]]; then
        log "INFO" "All entries are videos; using daemon per-monitor mode"
        "$daemon" --per-monitor "${video_paths[@]}" >/dev/null 2>&1 &
        local pid=$!
        disown
        echo "$pid" > "$VIDEO_PID_FILE"
        log "INFO" "Per-monitor video wallpaper started (PID $pid)"
        return 0
    fi

    get_total_span || return 1
    mkdir -p "$CACHE_DIR"

    local mode="${CONFIG[mode]}"
    local key_string="mixed|${CONFIG[bg_type]}|${CONFIG[blur]}|${CONFIG[color]}|${TOTAL_WIDTH}x${TOTAL_HEIGHT}|${mode}"
    for i in $(seq 0 $((MONITOR_COUNT-1))); do
        local e="${entries[i]}"
        if [[ "$e" == "none" ]]; then
            key_string+="|none"
        else
            local abs_e
            abs_e="$(readlink -f "$e")"
            key_string+="|${abs_e}|$(get_file_mtime "$abs_e")"
        fi
    done
    local cache_key
    cache_key="$(echo -n "$key_string" | md5sum | cut -d' ' -f1)"
    local cache_file="${CACHE_DIR}/${cache_key}.jpg"

    if [[ ! -f "$cache_file" ]]; then
        log "INFO" "Building mixed-media static background..."
        _build_mixed_canvas "$cache_file" "${entries[@]}" || return 1
    else
        log "INFO" "Using cached mixed-media background"
    fi

    _apply_per_monitor_backend "$cache_file" || return 1

    if [[ ${#video_indices[@]} -eq 0 ]]; then
        log "INFO" "Static-only mixture; no videos to launch"
        return 0
    fi

    local -a on_args=()
    for i in "${!video_indices[@]}"; do
        on_args+=("${video_indices[$i]}:${video_paths[$i]}")
    done

    log "INFO" "Starting daemon with --on ${on_args[*]}"
    "$daemon" --on "${on_args[@]}" >/dev/null 2>&1 &
    local pid=$!
    disown
    echo "$pid" > "$VIDEO_PID_FILE"
    log "INFO" "Mixed media wallpaper started (PID $pid)"
    return 0
}

# ----------------------------------------------------------------------
# Refresh and helpers
# ----------------------------------------------------------------------
refresh_wallpaper() {
    assert_file_exists "$STATE_FILE" || { log "WARN" "No wallpaper state found"; return 1; }

    local recent_line mode saved_bg_type saved_blur_or_color
    recent_line="$(head -n1 "$STATE_FILE")"
    mode="$(sed -n '2p' "$STATE_FILE" | head -n1)"
    saved_bg_type="$(sed -n '3p' "$STATE_FILE")"
    saved_blur_or_color="$(sed -n '4p' "$STATE_FILE")"

    [[ -z "$mode" ]] && mode="${CONFIG[mode]}"
    [[ -z "$saved_bg_type" ]] && saved_bg_type="${CONFIG[bg_type]}"

    local old_bg_type="${CONFIG[bg_type]}"
    local old_blur="${CONFIG[blur]}"
    local old_color="${CONFIG[color]}"

    CONFIG[bg_type]="$saved_bg_type"
    if [[ "$saved_bg_type" == "blur" ]]; then
        CONFIG[blur]="${saved_blur_or_color:-${CONFIG[blur]}}"
    else
        CONFIG[color]="${saved_blur_or_color:-${CONFIG[color]}}"
    fi

    if [[ "$recent_line" =~ ^per-monitor:(.*) ]]; then
        local pm_list="${BASH_REMATCH[1]}"
        local -a img_array
        IFS='|' read -ra img_array <<< "$pm_list"
        set_per_monitor_wallpaper "${img_array[@]}" "$mode"
    else
        local recent_image="$recent_line"
        if [[ -f "$recent_image" ]]; then
            set_wallpaper "$recent_image" "$mode" "true"
        else
            log "WARN" "Stored image not found; cannot refresh."
            CONFIG[bg_type]="$old_bg_type"
            CONFIG[blur]="$old_blur"
            CONFIG[color]="$old_color"
            return 1
        fi
    fi

    CONFIG[bg_type]="$old_bg_type"
    CONFIG[blur]="$old_blur"
    CONFIG[color]="$old_color"
    return 0
}

is_fullscreen_active() {
    local active_window
    active_window="$(xprop -root _NET_ACTIVE_WINDOW 2>/dev/null | awk '{print $5}')"
    [[ -n "$active_window" ]] || return 1
    xprop -id "$active_window" _NET_WM_STATE 2>/dev/null | grep -q "_NET_WM_STATE_FULLSCREEN"
}

# ----------------------------------------------------------------------
# Random rotation
# ----------------------------------------------------------------------
pick_random_image() {
    local dir="$1"
    local images=()
    assert_dir_exists "$dir" || return 1

    while IFS= read -r -d $'\0' file; do
        images+=("$file")
    done < <(find "$dir" -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" \) -print0)
    if [[ ${#images[@]} -eq 0 ]]; then
        log "ERROR" "No images in $dir"
        return 1
    fi
    echo "${images[RANDOM % ${#images[@]}]}"
    return 0
}

start_random_mode() {
    local directory="$1" mode="${2:-${CONFIG[mode]}}"
    local interval="${CONFIG[random_interval]}"
    local first_image
    local iterations=0

    assert_dir_exists "$directory" || return 1

    {
        echo "directory=$directory"
        echo "mode=$mode"
        echo "interval=$interval"
        echo "pid=$$"
    } > "$RANDOM_FILE"

    first_image="$(pick_random_image "$directory")" || return 1
    set_wallpaper "$first_image" "$mode" || return 1

    (
        while (( iterations < WATCHDOG_LIMIT )); do
            ((iterations++))
            sleep $((interval * 60))
            [[ -f "$RANDOM_FILE" ]] || exit 0
            local new_img
            new_img="$(pick_random_image "$directory")" || continue
            set_wallpaper "$new_img" "$mode"
        done
        log "ERROR" "Random rotation loop exceeded limit. Exiting."
        exit 0
    ) &
    echo $! >> "$RANDOM_FILE"
    log "INFO" "Random rotation started (PID $!)"
    return 0
}

start_random_multi_mode() {
    local directory="$1" mode="${2:-${CONFIG[mode]}}"
    local interval="${CONFIG[random_interval]}"
    local N images=()
    local iterations=0

    assert_dir_exists "$directory" || return 1
    get_monitor_info || return 1
    N=$MONITOR_COUNT

    while IFS= read -r -d $'\0' file; do
        images+=("$file")
    done < <(find "$directory" -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" \) -print0)
    [[ ${#images[@]} -ge $N ]] || { log "ERROR" "Need at least $N images"; return 1; }

    {
        echo "directory=$directory"
        echo "mode=$mode"
        echo "interval=$interval"
        echo "pid=$$"
        echo "multi=true"
    } > "$RANDOM_FILE"

    pick_random_set() {
        local selected=() indices=()
        while [[ ${#indices[@]} -lt $N ]]; do
            local idx=$((RANDOM % ${#images[@]}))
            local already_present=false
            local existing
            for existing in "${indices[@]}"; do
                if [[ "$existing" == "$idx" ]]; then
                    already_present=true
                    break
                fi
            done
            if [[ "$already_present" == false ]]; then
                indices+=("$idx")
            fi
        done
        for idx in "${indices[@]}"; do selected+=("${images[$idx]}"); done
        printf '%s\n' "${selected[@]}"
    }

    local first_set
    readarray -t first_set < <(pick_random_set)
    set_per_monitor_wallpaper "${first_set[@]}" "$mode" || return 1

    (
        while (( iterations < WATCHDOG_LIMIT )); do
            ((iterations++))
            sleep $((interval * 60))
            [[ -f "$RANDOM_FILE" ]] || exit 0
            local new_set
            readarray -t new_set < <(pick_random_set)
            set_per_monitor_wallpaper "${new_set[@]}" "$mode"
        done
        log "ERROR" "Random multi rotation loop exceeded limit. Exiting."
        exit 0
    ) &
    echo $! >> "$RANDOM_FILE"
    log "INFO" "Random multi rotation started (PID $!)"
    return 0
}

stop_random_mode() {
    if [[ -f "$RANDOM_FILE" ]]; then
        local pid
        pid="$(tail -n1 "$RANDOM_FILE")"
        kill "$pid" 2>/dev/null || true
        rm -f "$RANDOM_FILE"
        log "INFO" "Random rotation stopped."
    else
        log "WARN" "Random rotation not active."
    fi
    return 0
}

# ----------------------------------------------------------------------
# Refresh daemon
# ----------------------------------------------------------------------
start_refresh_mode() {
    local interval="${1:-${CONFIG[refresh_interval]}}"
    local refresh_pid
    local iterations=0

    assert_positive_int "$interval" || return 1
    stop_refresh_mode
    sleep 0.5

    mkdir -p "$CONFIG_DIR"
    {
        echo "interval=$interval"
        echo "pid=$$"
    } > "$REFRESH_FILE"

    do_refresh() {
        while (( iterations < WATCHDOG_LIMIT )); do
            ((iterations++))
            sleep $((interval * 60))
            [[ -f "$REFRESH_FILE" ]] || exit 0
            log "INFO" "Auto-refreshing wallpaper"
            refresh_wallpaper
        done
        log "ERROR" "Refresh loop exceeded limit. Exiting."
        exit 0
    }

    do_refresh &
    refresh_pid=$!
    echo $refresh_pid >> "$REFRESH_FILE"
    log "INFO" "Periodic refresh started (PID $refresh_pid)"

    if [[ "${CONFIG[fullscreen_pause]}" == "true" ]]; then
        monitor_fullscreen &
        echo $! > "$FULLSCREEN_FILE"
    fi

    if [[ ! -f "$LAYOUT_MONITOR_PIDFILE" ]] || ! kill -0 "$(cat "$LAYOUT_MONITOR_PIDFILE")" 2>/dev/null; then
        monitor_layout &
        echo $! > "$LAYOUT_MONITOR_PIDFILE"
    fi

    if [[ "${CONFIG[per_workspace]}" == "true" ]]; then
        monitor_workspace &
        echo $! >> "$LAYOUT_MONITOR_PIDFILE"
    fi
    return 0
}

stop_refresh_mode() {
    if [[ -f "$REFRESH_FILE" ]]; then
        local refresh_pid
        refresh_pid="$(tail -n1 "$REFRESH_FILE")"
        if [[ -n "$refresh_pid" ]] && kill -0 "$refresh_pid" 2>/dev/null; then
            kill "$refresh_pid" 2>/dev/null || true
        fi
        rm -f "$REFRESH_FILE"
    fi

    if [[ -f "$FULLSCREEN_FILE" ]]; then
        local fs_pid
        fs_pid="$(cat "$FULLSCREEN_FILE")"
        if [[ -n "$fs_pid" ]] && kill -0 "$fs_pid" 2>/dev/null; then
            kill "$fs_pid" 2>/dev/null || true
        fi
        rm -f "$FULLSCREEN_FILE"
    fi

    if [[ -f "$LAYOUT_MONITOR_PIDFILE" ]]; then
        local pids
        pids="$(cat "$LAYOUT_MONITOR_PIDFILE")"
        for pid in $pids; do
            if kill -0 "$pid" 2>/dev/null; then
                kill "$pid" 2>/dev/null || true
            fi
        done
        rm -f "$LAYOUT_MONITOR_PIDFILE"
    fi

    pkill -f "ultraspan.*refresh" 2>/dev/null || true
    pkill -f "ultraspan.*monitor_fullscreen" 2>/dev/null || true
    pkill -f "ultraspan.*monitor_layout" 2>/dev/null || true
    pkill -f "ultraspan.*monitor_workspace" 2>/dev/null || true

    log "INFO" "Periodic refresh stopped."
    return 0
}

_ensure_fullscreen_monitor() {
    [[ "${CONFIG[fullscreen_pause]}" == "true" ]] || return 0

    if [[ -f "$FULLSCREEN_FILE" ]]; then
        local fs_pid
        fs_pid="$(cat "$FULLSCREEN_FILE")"
        if [[ -n "$fs_pid" ]] && kill -0 "$fs_pid" 2>/dev/null; then
            return 0   # already running
        fi
        rm -f "$FULLSCREEN_FILE"   # stale
    fi

    log "INFO" "Starting fullscreen monitor"
    monitor_fullscreen &
    echo $! > "$FULLSCREEN_FILE"
    return 0
}

_pause_all_services() {
    local refresh_pid="" random_pid=""
    [[ -f "$REFRESH_FILE" ]] && refresh_pid="$(tail -n1 "$REFRESH_FILE")"
    [[ -f "$RANDOM_FILE" ]] && random_pid="$(tail -n1 "$RANDOM_FILE")"
    [[ -n "$refresh_pid" ]] && kill -STOP "$refresh_pid" 2>/dev/null || true
    [[ -n "$random_pid" ]] && kill -STOP "$random_pid" 2>/dev/null || true
    if [[ -f "$VIDEO_PID_FILE" ]]; then
        kill -USR1 "$(cat "$VIDEO_PID_FILE")" 2>/dev/null
    fi
}

_resume_all_services() {
    local refresh_pid="" random_pid=""
    [[ -f "$REFRESH_FILE" ]] && refresh_pid="$(tail -n1 "$REFRESH_FILE")"
    [[ -f "$RANDOM_FILE" ]] && random_pid="$(tail -n1 "$RANDOM_FILE")"
    [[ -n "$refresh_pid" ]] && kill -CONT "$refresh_pid" 2>/dev/null || true
    [[ -n "$random_pid" ]] && kill -CONT "$random_pid" 2>/dev/null || true
    if [[ -f "$VIDEO_PID_FILE" ]]; then
        kill -USR2 "$(cat "$VIDEO_PID_FILE")" 2>/dev/null
    fi
}

# ----------------------------------------------------------------------
# Fullscreen & layout monitors
# ----------------------------------------------------------------------
monitor_fullscreen() {
    # state:
    #   running   – no fullscreen; wallpaper plays
    #   paused_fs – fullscreen active; wallpaper paused
    #   grace     – fullscreen just ended; waiting `grace` seconds before resume
    local state="running"
    local resume_at=0
    local grace=5
    local now
    local iterations=0

    while (( iterations < WATCHDOG_LIMIT )); do
        ((iterations++))
        sleep 2
        now="$(date +%s)"

        if is_fullscreen_active; then
            case "$state" in
                running)
                    log "INFO" "Full-screen detected – pausing services"
                    _pause_all_services
                    state="paused_fs"
                    ;;
                grace)
                    log "INFO" "Full-screen returned during grace – staying paused"
                    state="paused_fs"
                    ;;
                paused_fs)
                    ;;
            esac
            resume_at=0
        else
            case "$state" in
                paused_fs)
                    # Reload config so grace can be changed live.
                    load_config
                    grace="${CONFIG[fullscreen_grace_seconds]:-5}"
                    if ! [[ "$grace" =~ ^[0-9]+$ ]] || (( grace < 0 )); then
                        grace=5
                    fi
                    resume_at=$(( now + grace ))
                    log "INFO" "Full-screen ended – resuming in ${grace}s"
                    state="grace"
                    ;;
                grace)
                    if (( now >= resume_at )); then
                        log "INFO" "Grace elapsed – resuming services"
                        _resume_all_services
                        state="running"
                        resume_at=0
                    fi
                    ;;
                running)
                    ;;
            esac
        fi
    done
    log "ERROR" "Fullscreen monitor exceeded limit. Exiting."
    exit 0
}

monitor_layout() {
    local last_layout=""
    local iterations=0
    while (( iterations < WATCHDOG_LIMIT )); do
        ((iterations++))
        sleep 2
        local current_layout
        current_layout="$(xrandr --current --listmonitors 2>/dev/null | md5sum | cut -d' ' -f1)"
        if [[ -n "$last_layout" ]] && [[ "$current_layout" != "$last_layout" ]]; then
            log "INFO" "Display layout changed – reapplying wallpaper"
            refresh_wallpaper
        fi
        last_layout="$current_layout"
    done
    log "ERROR" "Layout monitor exceeded limit. Exiting."
    exit 0
}

monitor_workspace() {
    sleep 2
    local last_ws=""
    local iterations=0
    while (( iterations < WATCHDOG_LIMIT )); do
        ((iterations++))
        load_config
        local new_ws
        new_ws="$(xdotool get_desktop 2>/dev/null || echo 0)"
        if [[ "$new_ws" != "$last_ws" ]]; then
            if [[ "${CONFIG[per_workspace]}" == "true" ]]; then
                log "INFO" "Workspace changed to $new_ws"
                STATE_FILE="$(get_state_file "$new_ws")"
                refresh_wallpaper
            fi
            last_ws="$new_ws"
        fi
        sleep 1
    done
    log "ERROR" "Workspace monitor exceeded limit. Exiting."
    exit 0
}

# ----------------------------------------------------------------------
# Daemon with flags
# ----------------------------------------------------------------------
start_daemon() {
    local mode="${1:-background}"
    local iterations=0

    mkdir -p "$PID_DIR"
    if [[ -f "$DAEMON_PIDFILE" ]] && kill -0 "$(cat "$DAEMON_PIDFILE")" 2>/dev/null; then
        log "ERROR" "Daemon already running (PID $(cat "$DAEMON_PIDFILE"))."
        return 1
    fi

    acquire_lock || return 1
    stop_refresh_mode
    stop_random_mode
    release_lock

    log "INFO" "Starting ultraspan daemon (mode: $mode)..."

    case "$mode" in
        foreground)
            echo "$$" > "$DAEMON_PIDFILE"
            start_refresh_mode "${CONFIG[refresh_interval]}" || return 1
            start_saved_random || return 1
            while (( iterations < WATCHDOG_LIMIT )); do
                ((iterations++))
                sleep 3600
            done
            log "ERROR" "Daemon idle loop exceeded limit. Exiting."
            exit 0
            ;;
        oneshot)
            echo "$$" > "$DAEMON_PIDFILE"
            start_refresh_mode "${CONFIG[refresh_interval]}" || return 1
            start_saved_random || return 1
            exit 0
            ;;
        *)
            (
                echo "$BASHPID" > "$DAEMON_PIDFILE"
                start_refresh_mode "${CONFIG[refresh_interval]}" || exit 1
                start_saved_random || exit 1
                while (( iterations < WATCHDOG_LIMIT )); do
                    ((iterations++))
                    sleep 3600
                done
                log "ERROR" "Daemon idle loop exceeded limit. Exiting."
                exit 0
            ) &
            disown
            log "INFO" "Daemon sent to background."
            exit 0
            ;;
    esac
}

start_saved_random() {
    if [[ -f "$RANDOM_FILE" ]]; then
        local dir mode multi
        while IFS='=' read -r key value; do
            case "$key" in
                directory) dir="$value" ;;
                mode) mode="$value" ;;
                multi) multi="$value" ;;
            esac
        done < "$RANDOM_FILE"
        if [[ -n "$dir" ]]; then
            if [[ "$multi" == "true" ]]; then
                start_random_multi_mode "$dir" "$mode" || return 1
            else
                start_random_mode "$dir" "$mode" || return 1
            fi
        fi
    fi
    return 0
}

# ----------------------------------------------------------------------
# Data wipe
# ----------------------------------------------------------------------
data_wipe_ultraspan() {
    echo "This will remove ALL ultraspan configuration, cache, and state files."
    echo "Your wallpapers will be reset to the system default."
    read -r -p "Are you sure? (y/N) " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        echo "Aborted."
        return 0
    fi

    release_lock
    stop_daemon
    stop_refresh_mode
    stop_random_mode
    stop_video_wallpaper

    rm -rf "$CONFIG_DIR" "$CACHE_DIR" "$PID_DIR" "$LOCK_FILE"

    local default_wp="/usr/share/backgrounds/linuxmint/default_background.jpg"
    if [[ -f "$default_wp" ]]; then
        gsettings set org.cinnamon.desktop.background picture-uri "file://$default_wp"
    else
        gsettings reset org.cinnamon.desktop.background picture-uri
    fi
    gsettings set org.cinnamon.desktop.background picture-options "zoom"

    echo "All ultraspan data removed. You may now delete the script itself."
    return 0
}

# ----------------------------------------------------------------------
# Stop daemon
# ----------------------------------------------------------------------
stop_daemon() {
    if [[ -f "$DAEMON_PIDFILE" ]]; then
        local pid
        pid="$(cat "$DAEMON_PIDFILE")"
        if kill -0 "$pid" 2>/dev/null; then
            kill -TERM "$pid" 2>/dev/null || true
            log "INFO" "Daemon stopped."
        fi
        rm -f "$DAEMON_PIDFILE"
    fi
    stop_refresh_mode
    stop_random_mode
    stop_video_wallpaper
    return 0
}

# ----------------------------------------------------------------------
# Diagnose
# ----------------------------------------------------------------------
_diagnose_dependencies() {
    echo "Dependencies:"
    for cmd in xrandr gsettings md5sum bc xdotool ffmpeg; do
        if command -v "$cmd" &>/dev/null; then
            echo "  ✅ $cmd"
        else
            echo "  ❌ $cmd (optional)"
        fi
    done
}

_diagnose_config() {
    echo "Config:"
    for k in "${!CONFIG[@]}"; do
        echo "  $k = ${CONFIG[$k]}"
    done
}

_diagnose_monitors() {
    echo "Monitor layout:"
    get_monitor_info || return 1
    echo "  Count: $MONITOR_COUNT"
    for i in $(seq 0 $((MONITOR_COUNT-1))); do
        echo "  ${MONITOR_NAMES[i]}: ${MONITOR_W[i]}x${MONITOR_H[i]} at ${MONITOR_X[i]},${MONITOR_Y[i]}"
    done
    return 0
}

_diagnose_services() {
    echo "Cache: $(du -sh "$CACHE_DIR" 2>/dev/null | cut -f1)"
    echo "State file: $(head -n1 "$STATE_FILE" 2>/dev/null)"
    if [[ -f "$REFRESH_FILE" ]]; then
        echo "Refresh: active (PID $(tail -n1 "$REFRESH_FILE"))"
    else
        echo "Refresh: inactive"
    fi
    if [[ -f "$RANDOM_FILE" ]]; then
        echo "Random: active (PID $(tail -n1 "$RANDOM_FILE"))"
    else
        echo "Random: inactive"
    fi
    if [[ -f "$DAEMON_PIDFILE" ]] && kill -0 "$(cat "$DAEMON_PIDFILE")" 2>/dev/null; then
        echo "Daemon: running (PID $(cat "$DAEMON_PIDFILE"))"
    else
        echo "Daemon: not running"
    fi
    if [[ -f "$VIDEO_PID_FILE" ]] && kill -0 "$(cat "$VIDEO_PID_FILE")" 2>/dev/null; then
        echo "Video: running (PID $(cat "$VIDEO_PID_FILE"))"
    else
        echo "Video: not running"
    fi
}

diagnose() {
    echo "=== Ultraspan Diagnose ==="
    echo "Version: $VERSION"
    echo "Bash: $BASH_VERSION"
    echo "ImageMagick: $($IM_CMD -version | head -1)"
    _diagnose_dependencies
    _diagnose_config
    _diagnose_monitors || return 1
    _diagnose_services
    return 0
}

# ----------------------------------------------------------------------
# Preview / list
# ----------------------------------------------------------------------
preview_wallpaper() {
    local image="$1" mode="${2:-${CONFIG[mode]}}"
    local scale="800" scale_w scale_h temp_file

    assert_file_exists "$image" || return 1
    get_total_span || return 1

    if [[ $TOTAL_WIDTH -gt $TOTAL_HEIGHT ]]; then
        scale_w=$scale
        scale_h=$((TOTAL_HEIGHT * scale / TOTAL_WIDTH))
    else
        scale_h=$scale
        scale_w=$((TOTAL_WIDTH * scale / TOTAL_HEIGHT))
    fi

    temp_file="$(mktemp --suffix=.jpg)"
    $IM_CMD "$image" -resize "${scale_w}x${scale_h}" "$temp_file"
    echo "Preview saved to $temp_file"
    if command -v display &>/dev/null; then
        display "$temp_file"
    else
        xdg-open "$temp_file" 2>/dev/null || log "INFO" "Open $temp_file with your image viewer."
    fi
    return 0
}

list_images() {
    local dir="$1"
    assert_dir_exists "$dir" || return 1

    printf "%-40s %8s %8s\n" "Filename" "Width" "Height"
    find "$dir" -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" \) -print0 | while IFS= read -r -d '' file; do
        local w h
        w="$($IM_IDENTIFY -format "%w" "$file" 2>/dev/null)" || w="?"
        h="$($IM_IDENTIFY -format "%h" "$file" 2>/dev/null)" || h="?"
        printf "%-40s %8s %8s\n" "$(basename "$file")" "$w" "$h"
    done
    return 0
}

# ----------------------------------------------------------------------
# Systemd and completion generators
# ----------------------------------------------------------------------
generate_systemd() {
    cat <<EOF
[Unit]
Description=Ultraspan Wallpaper Daemon
After=graphical-session.target

[Service]
Type=forking
ExecStart=${BASH_SOURCE[0]} daemon
ExecStop=${BASH_SOURCE[0]} daemon-stop
Restart=on-failure
User=%i

[Install]
WantedBy=default.target
EOF
}

generate_completion() {
    cat <<'EOF'
_ultraspan() {
    local cur prev words cword
    _init_completion || return
    case $prev in
        set|set-per-monitor|random|random-multi|preview|info|list-images|set-video|set-video-span|set-video-per-monitor|set-media)
            _filedir
            return
            ;;
        set-video-on)
            _filedir
            return
            ;;
        mode|bg-type|blur|color|fullscreen|interval|backend)
            return
            ;;
    esac
    if [[ $cword -eq 1 ]]; then
        COMPREPLY=($(compgen -W "
            set set-per-monitor
            set-video set-video-span set-video-per-monitor set-video-on set-media
            pause-video resume-video stop-video
            random random-multi random-stop random-status
            interval
            refresh-start refresh-stop refresh-status refresh-wallpaper
            status info list-images preview
            diagnose
            daemon daemon-stop
            data-wipe
            set-config
            mode bg-type blur color fullscreen backend
            clean restore
            generate-systemd generate-completion
            help --version
        " -- "$cur"))
    fi
}
complete -F _ultraspan ultraspan
EOF
}

