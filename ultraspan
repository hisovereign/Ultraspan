#!/bin/bash
# ============================================
# Combined Single-Span Multi-Monitor Wallpaper Utility
# ============================================
# Version 4.1 - Brought to you by hisovereign
# ============================================

export MAGICK_THREAD_LIMIT=1   # optional: remove this line if you want full speed

VERSION="4.1"
CONFIG_DIR="$HOME/.config/ultraspan"
CONFIG_FILE="$CONFIG_DIR/config"
CACHE_DIR="$HOME/.cache/ultraspan"
STATE_FILE="$CONFIG_DIR/state"
RANDOM_FILE="$CONFIG_DIR/random"
REFRESH_FILE="$CONFIG_DIR/refresh"
LOCK_FILE="/tmp/ultraspan.lock"
FULLSCREEN_FILE="$CONFIG_DIR/fullscreen"
LAYOUT_MONITOR_PIDFILE="$CONFIG_DIR/layout_monitor.pid"
LOG_FILE="$CACHE_DIR/ultraspan.log"
DEBUG=false

# Default settings
MODE="zoom"
BG_TYPE="blur"
BLUR_AMOUNT=15
BG_COLOR="#000000"
FULLSCREEN_PAUSE="true"
RANDOM_INTERVAL=30

# ImageMagick detection
if command -v magick &>/dev/null; then
    IM_CMD="magick"
    IM_IDENTIFY="magick identify"
else
    IM_CMD="convert"
    IM_IDENTIFY="identify"
fi

# -----------------------------
# SINGLE-INSTANCE LOCK
# -----------------------------
exec 9>"$LOCK_FILE" || exit 1
if ! flock -n 9; then
    echo "❌ Another instance of ultraspan is already running." >&2
    exit 1
fi

cleanup() {
    flock -u 9 2>/dev/null
    exec 9>&-
    if [ -f "$LAYOUT_MONITOR_PIDFILE" ]; then
        local pid
        pid=$(cat "$LAYOUT_MONITOR_PIDFILE" 2>/dev/null)
        if [ "$pid" = "$$" ] || kill -0 "$pid" 2>/dev/null; then
            rm -f "$LAYOUT_MONITOR_PIDFILE"
        fi
    fi
}
trap cleanup EXIT

debug_log() {
    [ "$DEBUG" = true ] && echo "$(date '+%Y-%m-%d %H:%M:%S') - $*" >> "$LOG_FILE"
}

# ---------- Monitor geometry helpers (unchanged) ----------
get_monitor_info() {
    unset MONITOR_NAMES MONITOR_X MONITOR_Y MONITOR_W MONITOR_H
    MIN_X=99999; MIN_Y=99999; MAX_X=0; MAX_Y=0
    local index=0
    while IFS= read -r line; do
        if [[ $line =~ ([0-9]+:[[:space:]]+[\+\*]*)([A-Za-z0-9-]+)[[:space:]]+([0-9]+)\/[0-9]+x([0-9]+)\/[0-9]+\+([0-9]+)\+([0-9]+) ]]; then
            MONITOR_NAMES[index]="${BASH_REMATCH[2]}"
            MONITOR_X[index]="${BASH_REMATCH[5]}"
            MONITOR_Y[index]="${BASH_REMATCH[6]}"
            MONITOR_W[index]="${BASH_REMATCH[3]}"
            MONITOR_H[index]="${BASH_REMATCH[4]}"
            (( MONITOR_X[index] < MIN_X )) && MIN_X=${MONITOR_X[index]}
            (( MONITOR_Y[index] < MIN_Y )) && MIN_Y=${MONITOR_Y[index]}
            local x2=$((MONITOR_X[index] + MONITOR_W[index]))
            local y2=$((MONITOR_Y[index] + MONITOR_H[index]))
            (( x2 > MAX_X )) && MAX_X=$x2
            (( y2 > MAX_Y )) && MAX_Y=$y2
            ((index++))
        fi
    done < <(xrandr --listmonitors 2>/dev/null)
    MONITOR_COUNT=$index
}

get_total_span() {
    get_monitor_info
    TOTAL_WIDTH=$((MAX_X - MIN_X))
    TOTAL_HEIGHT=$((MAX_Y - MIN_Y))
}

# ---------- Config helpers (unchanged) ----------
load_config() {
    if [ -f "$CONFIG_FILE" ]; then
        local key value
        while IFS='=' read -r key value; do
            key="${key## }"; key="${key%% }"
            value="${value## }"; value="${value%% }"
            case "$key" in
                "mode") MODE="$value" ;;
                "bg_type") BG_TYPE="$value" ;;
                "blur") BLUR_AMOUNT="$value" ;;
                "color") BG_COLOR="$value" ;;
                "fullscreen_pause") FULLSCREEN_PAUSE="$value" ;;
                "random_interval") RANDOM_INTERVAL="$value" ;;
            esac
        done < "$CONFIG_FILE"
    fi
}

get_default_mode() {
    load_config
    echo "${MODE:-zoom}"
}

update_config() {
    local key="$1"
    local value="$2"
    local temp_file
    mkdir -p "$CONFIG_DIR"
    temp_file=$(mktemp)
    if [ -f "$CONFIG_FILE" ]; then
        grep -v "^${key}=" "$CONFIG_FILE" > "$temp_file" 2>/dev/null || true
    else
        touch "$temp_file"
    fi
    echo "${key}=${value}" >> "$temp_file"
    mv "$temp_file" "$CONFIG_FILE"
}

# ---------- Image processing for a single monitor area ----------
process_image_for_area() {
    local image="$1"
    local area_w="$2"
    local area_h="$3"
    local mode="$4"
    local outfile
    outfile=$(mktemp) || { echo "❌ Failed to create temp file" >&2; return 1; }

    local img_w img_h
    img_w=$($IM_IDENTIFY -format "%w" "$image" 2>/dev/null) || img_w=0
    img_h=$($IM_IDENTIFY -format "%h" "$image" 2>/dev/null) || img_h=0

    case "$mode" in
        zoom)
            $IM_CMD "$image" -resize "${area_w}x${area_h}^" -gravity center -extent "${area_w}x${area_h}" "$outfile"
            ;;
        fit)
            $IM_CMD "$image" -resize "${area_w}x${area_h}" "$outfile"
            ;;
        center)
            local fit_w fit_h
            if [ "$img_w" -gt "$img_h" ]; then
                fit_w=$(( area_w * 80 / 100 ))
                fit_h=$(( img_h * fit_w / img_w ))
            else
                fit_h=$(( area_h * 80 / 100 ))
                fit_w=$(( img_w * fit_h / img_h ))
            fi
            [ "$fit_w" -gt "$area_w" ] && fit_w=$area_w
            [ "$fit_h" -gt "$area_h" ] && fit_h=$area_h
            $IM_CMD "$image" -resize "${fit_w}x${fit_h}" "$outfile"
            ;;
        *) echo "❌ Unknown mode: $mode" >&2; return 1 ;;
    esac
    echo "$outfile"
}

# ---------- Single wallpaper (unchanged) ----------
set_wallpaper() {
    local image="$1"
    local mode="${2:-zoom}"
    local force="${3:-false}"

    [ -f "$image" ] || { echo "❌ Error: File not found: $image"; exit 1; }

    echo "🎨 Setting wallpaper: $(basename "$image")"
    echo "📐 Mode: $mode"
    echo "🎨 Background: $BG_TYPE"
    if [ "$BG_TYPE" = "blur" ]; then
        echo "🎭 Blur amount: $BLUR_AMOUNT"
    else
        echo "🎨 Solid color: $BG_COLOR"
    fi

    get_total_span
    [ "$TOTAL_WIDTH" -eq 0 ] || [ "$TOTAL_HEIGHT" -eq 0 ] && { echo "❌ Error: Could not determine monitor layout"; exit 1; }

    echo "🖥️  Monitor span: ${TOTAL_WIDTH}x${TOTAL_HEIGHT}"

    mkdir -p "$CACHE_DIR"
    mkdir -p "$(dirname "$STATE_FILE")"

    # Cache key from absolute path (resolved) + parameters
    local abs_image
    abs_image=$(readlink -f "$image")
    local key_string="${abs_image}|${mode}|${BG_TYPE}|${BLUR_AMOUNT}|${BG_COLOR}|${TOTAL_WIDTH}x${TOTAL_HEIGHT}"
    local cache_key
    cache_key=$(echo -n "$key_string" | md5sum | cut -d' ' -f1)
    local CACHE_FILE="$CACHE_DIR/${cache_key}.jpg"

    debug_log "force=$force, cache=$CACHE_FILE"

    if [ "$force" = "true" ] || [ ! -f "$CACHE_FILE" ]; then
        echo "⚙️  Processing image..."
        local img_w img_h
        img_w=$($IM_IDENTIFY -format "%w" "$image" 2>/dev/null || echo "0")
        img_h=$($IM_IDENTIFY -format "%h" "$image" 2>/dev/null || echo "0")
        echo "📐 Original image: ${img_w}x${img_h}"

        case "$mode" in
            zoom)
                $IM_CMD "$image" -resize "${TOTAL_WIDTH}x${TOTAL_HEIGHT}^" -gravity center -extent "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" -quality 95 "$CACHE_FILE"
                ;;
            fit)
                if [ "$BG_TYPE" = "blur" ]; then
                    $IM_CMD "$image" \
                        \( -clone 0 -resize "${TOTAL_WIDTH}x${TOTAL_HEIGHT}^" -gravity center -extent "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" -blur "0x${BLUR_AMOUNT}" \) \
                        \( -clone 0 -resize "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" \) \
                        -delete 0 -gravity center -composite -quality 95 "$CACHE_FILE"
                else
                    $IM_CMD "$image" -resize "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" -background "$BG_COLOR" -gravity center -extent "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" -quality 95 "$CACHE_FILE"
                fi
                ;;
            center)
                if [ "$BG_TYPE" = "blur" ]; then
                    local blur_bg=$(mktemp) center_fg=$(mktemp)
                    $IM_CMD "$image" -resize "${TOTAL_WIDTH}x${TOTAL_HEIGHT}^" -gravity center -extent "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" -blur "0x${BLUR_AMOUNT}" "$blur_bg"
                    local fit_w fit_h
                    if [ "$img_w" -gt "$img_h" ]; then
                        fit_w=$((TOTAL_WIDTH * 80 / 100))
                        fit_h=$((img_h * fit_w / img_w))
                    else
                        fit_h=$((TOTAL_HEIGHT * 80 / 100))
                        fit_w=$((img_w * fit_h / img_h))
                    fi
                    [ "$fit_w" -gt "$TOTAL_WIDTH" ] && fit_w=$TOTAL_WIDTH
                    [ "$fit_h" -gt "$TOTAL_HEIGHT" ] && fit_h=$TOTAL_HEIGHT
                    $IM_CMD "$image" -resize "${fit_w}x${fit_h}" "$center_fg"
                    $IM_CMD "$blur_bg" "$center_fg" -gravity center -composite -quality 95 "$CACHE_FILE"
                    rm -f "$blur_bg" "$center_fg"
                else
                    local fit_w fit_h
                    if [ "$img_w" -gt "$img_h" ]; then
                        fit_w=$((TOTAL_WIDTH * 80 / 100))
                        fit_h=$((img_h * fit_w / img_w))
                    else
                        fit_h=$((TOTAL_HEIGHT * 80 / 100))
                        fit_w=$((img_w * fit_h / img_h))
                    fi
                    [ "$fit_w" -gt "$TOTAL_WIDTH" ] && fit_w=$TOTAL_WIDTH
                    [ "$fit_h" -gt "$TOTAL_HEIGHT" ] && fit_h=$TOTAL_HEIGHT
                    $IM_CMD "$image" -resize "${fit_w}x${fit_h}" -background "$BG_COLOR" -gravity center -extent "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" -quality 95 "$CACHE_FILE"
                fi
                ;;
            *) echo "❌ Error: Unknown mode: $mode"; exit 1 ;;
        esac
        [ -f "$CACHE_FILE" ] || { echo "❌ Error: Image processing failed"; exit 1; }
    else
        echo "⚙️  Using cached image"
        touch "$CACHE_FILE"
    fi

    echo "$image" > "$STATE_FILE"
    echo "$mode" >> "$STATE_FILE"
    echo "$BG_TYPE" >> "$STATE_FILE"
    if [ "$BG_TYPE" = "blur" ]; then
        echo "$BLUR_AMOUNT" >> "$STATE_FILE"
    else
        echo "$BG_COLOR" >> "$STATE_FILE"
    fi
    echo "$(date '+%Y-%m-%d %H:%M:%S')" >> "$STATE_FILE"

    gsettings set org.cinnamon.desktop.background picture-uri "file://$CACHE_FILE"
    gsettings set org.cinnamon.desktop.background picture-options "spanned"
    echo "✅ Wallpaper set successfully!"
}

# ---------- Per-monitor wallpaper (unchanged) ----------
set_per_monitor_wallpaper() {
    local images=("$@")
    local mode="${images[-1]}"

    case "$mode" in
        zoom|fit|center) unset 'images[-1]' ;;
        *) mode=$(get_default_mode) ;;
    esac

    get_monitor_info
    if [ ${#images[@]} -ne "$MONITOR_COUNT" ]; then
        echo "❌ Error: You must provide exactly $MONITOR_COUNT image(s)."
        exit 1
    fi

    for img in "${images[@]}"; do
        [ -f "$img" ] || { echo "❌ Error: File not found: $img"; exit 1; }
    done

    echo "🎨 Setting per‑monitor wallpaper ($MONITOR_COUNT monitors)"
    echo "📐 Mode: $mode"
    echo "🎨 Background: $BG_TYPE"

    get_total_span
    mkdir -p "$CACHE_DIR"

    local key_string="${mode}|${BG_TYPE}|${BLUR_AMOUNT}|${BG_COLOR}|${TOTAL_WIDTH}x${TOTAL_HEIGHT}"
    for img in "${images[@]}"; do
        key_string="${key_string}|$(readlink -f "$img")"
    done
    local cache_key
    cache_key=$(echo -n "$key_string" | md5sum | cut -d' ' -f1)
    local CACHE_FILE="$CACHE_DIR/${cache_key}.jpg"

    if [ ! -f "$CACHE_FILE" ]; then
        echo "⚙️  Processing images..."
        local bg_canvas
        bg_canvas=$(mktemp) || { echo "❌ Failed to create temp canvas"; exit 1; }
        if [ "$BG_TYPE" = "blur" ]; then
            $IM_CMD "${images[0]}" -resize "${TOTAL_WIDTH}x${TOTAL_HEIGHT}^" -gravity center -extent "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" -blur "0x${BLUR_AMOUNT}" "$bg_canvas"
        else
            $IM_CMD -size "${TOTAL_WIDTH}x${TOTAL_HEIGHT}" "xc:$BG_COLOR" "$bg_canvas"
        fi

        local i
        for i in $(seq 0 $((MONITOR_COUNT-1))); do
            local img="${images[i]}"
            local mon_w="${MONITOR_W[i]}"
            local mon_h="${MONITOR_H[i]}"
            local mon_x="${MONITOR_X[i]}"
            local mon_y="${MONITOR_Y[i]}"

            local processed
            processed=$(process_image_for_area "$img" "$mon_w" "$mon_h" "$mode") || exit 1

            local img_w img_h
            img_w=$($IM_IDENTIFY -format "%w" "$processed")
            img_h=$($IM_IDENTIFY -format "%h" "$processed")

            if [ "$mode" = "zoom" ]; then
                $IM_CMD "$bg_canvas" "$processed" -geometry +${mon_x}+${mon_y} -composite "$bg_canvas"
            else
                local offset_x=$(( mon_x + (mon_w - img_w) / 2 ))
                local offset_y=$(( mon_y + (mon_h - img_h) / 2 ))
                [ "$offset_x" -lt "$mon_x" ] && offset_x="$mon_x"
                [ "$offset_y" -lt "$mon_y" ] && offset_y="$mon_y"
                $IM_CMD "$bg_canvas" "$processed" -geometry +${offset_x}+${offset_y} -composite "$bg_canvas"
            fi
            rm -f "$processed"
        done

        $IM_CMD "$bg_canvas" -quality 95 "$CACHE_FILE"
        rm -f "$bg_canvas"
    else
        echo "⚙️  Using cached per‑monitor image"
        touch "$CACHE_FILE"
    fi

    local imgs_string
    imgs_string=$(printf "|%s" "${images[@]}")
    imgs_string="${imgs_string:1}"
    echo "per-monitor:$imgs_string" > "$STATE_FILE"
    echo "$mode" >> "$STATE_FILE"
    echo "$BG_TYPE" >> "$STATE_FILE"
    if [ "$BG_TYPE" = "blur" ]; then
        echo "$BLUR_AMOUNT" >> "$STATE_FILE"
    else
        echo "$BG_COLOR" >> "$STATE_FILE"
    fi
    echo "$(date '+%Y-%m-%d %H:%M:%S')" >> "$STATE_FILE"

    gsettings set org.cinnamon.desktop.background picture-uri "file://$CACHE_FILE"
    gsettings set org.cinnamon.desktop.background picture-options "spanned"
    echo "✅ Per‑monitor wallpaper set successfully!"
}

# ---------- Refresh / Rotation / Status (with wait calls) ----------

refresh_wallpaper() {
    if [ -f "$STATE_FILE" ]; then
        local recent_line
        recent_line=$(head -n1 "$STATE_FILE")
        if [[ "$recent_line" == per-monitor:* ]]; then
            local imgs="${recent_line#per-monitor:}"
            IFS='|' read -ra img_array <<< "$imgs"
            local mode
            mode=$(sed -n '2p' "$STATE_FILE")
            set_per_monitor_wallpaper "${img_array[@]}" "$mode"
            wait
        else
            local recent_image="$recent_line"
            local recent_mode
            recent_mode=$(sed -n '2p' "$STATE_FILE" || echo "zoom")
            if [ -f "$recent_image" ]; then
                set_wallpaper "$recent_image" "$recent_mode" "true"
                wait
            fi
        fi
    else
        echo "⚠️ No wallpaper state found"
        return 1
    fi
}

is_fullscreen_active() {
    local active_window
    active_window=$(xprop -root _NET_ACTIVE_WINDOW 2>/dev/null | awk '{print $5}')
    [ -n "$active_window" ] || return 1
    xprop -id "$active_window" _NET_WM_STATE 2>/dev/null | grep -q "_NET_WM_STATE_FULLSCREEN"
}

monitor_fullscreen() {
    # unchanged but safe
    local was_fullscreen=false
    local refresh_pid=""
    local random_pid=""

    while true; do
        sleep 2
        if [ -f "$REFRESH_FILE" ]; then
            refresh_pid=$(tail -n1 "$REFRESH_FILE" 2>/dev/null)
        fi
        if [ -f "$RANDOM_FILE" ]; then
            random_pid=$(tail -n1 "$RANDOM_FILE" 2>/dev/null)
        fi

        if is_fullscreen_active; then
            if [ "$was_fullscreen" = false ]; then
                echo "🎬 Full-screen detected - pausing wallpaper services"
                [ -n "$refresh_pid" ] && kill -STOP "$refresh_pid" 2>/dev/null && echo "   ⏸️  Refresh paused"
                [ -n "$random_pid" ] && kill -STOP "$random_pid" 2>/dev/null && echo "   ⏸️  Random rotation paused"
                was_fullscreen=true
            fi
        else
            if [ "$was_fullscreen" = true ]; then
                echo "🎬 Full-screen ended - resuming wallpaper services"
                [ -n "$refresh_pid" ] && kill -CONT "$refresh_pid" 2>/dev/null && echo "   ▶️  Refresh resumed"
                [ -n "$random_pid" ] && kill -CONT "$random_pid" 2>/dev/null && echo "   ▶️  Random rotation resumed"
                was_fullscreen=false
            fi
        fi
    done
}

monitor_layout() {
    local last_layout=""
    while true; do
        sleep 2
        local current_layout
        current_layout=$(xrandr --listmonitors 2>/dev/null | md5sum | cut -d' ' -f1)
        if [ -n "$last_layout" ] && [ "$current_layout" != "$last_layout" ]; then
            echo "🖥️  Display layout changed - reapplying wallpaper..."
            refresh_wallpaper > /dev/null 2>&1 || true
            wait
        fi
        last_layout="$current_layout"
    done
}

# ========== ROBUST STOP FUNCTION ==========
stop_refresh_mode() {
    local mypid=$$
    # Kill ALL refresh-start processes (parent, child, monitors) except this script itself
    for pid in $(pgrep -f "ultraspan refresh-start" 2>/dev/null); do
        [ "$pid" != "$mypid" ] && kill "$pid" 2>/dev/null
    done
    rm -f "$REFRESH_FILE" "$FULLSCREEN_FILE" "$LAYOUT_MONITOR_PIDFILE"
    echo "⏹️ Periodic refresh stopped"
}

start_refresh_mode() {
    local interval="${1:-180}"
    [[ "$interval" =~ ^[0-9]+$ ]] || { echo "❌ Error: Interval must be a positive number (minutes)"; exit 1; }

    # Stop any previous refresh instances first
    stop_refresh_mode
    # Small pause to ensure all children terminate
    sleep 0.5
    # Final check: if any other refresh-start is still alive (excluding us), abort
    local mypid=$$
    for pid in $(pgrep -f "ultraspan refresh-start" 2>/dev/null); do
        if [ "$pid" != "$mypid" ] && kill -0 "$pid" 2>/dev/null; then
            echo "❌ Failed to stop old refresh processes. Please try again."
            exit 1
        fi
    done

    mkdir -p "$CONFIG_DIR"
    echo "interval=$interval" > "$REFRESH_FILE"
    echo "pid=$$" >> "$REFRESH_FILE"

    do_refresh() {
        while true; do
            sleep $((interval * 60))
            [ -f "$REFRESH_FILE" ] || exit 0
            if [ -f "$STATE_FILE" ]; then
                echo "$(date) - 🔄 Auto-refreshing wallpaper"
                refresh_wallpaper
                wait
            fi
        done
    }

    do_refresh &
    local refresh_pid=$!
    echo $refresh_pid >> "$REFRESH_FILE"

    if [ "$FULLSCREEN_PAUSE" = "true" ]; then
        monitor_fullscreen &
        echo $! > "$FULLSCREEN_FILE"
    fi

    if [ ! -f "$LAYOUT_MONITOR_PIDFILE" ]; then
        monitor_layout &
        echo $! > "$LAYOUT_MONITOR_PIDFILE"
    fi

    echo "✅ Periodic refresh started (PID: $refresh_pid)"
    disown
}

show_refresh_status() {
    if [ -f "$REFRESH_FILE" ]; then
        local interval pid child_pid
        interval=$(head -n1 "$REFRESH_FILE" | cut -d= -f2)
        pid=$(sed -n '2p' "$REFRESH_FILE" | cut -d= -f2)
        child_pid=$(sed -n '3p' "$REFRESH_FILE")
        local running_pid=""
        [ -n "$child_pid" ] && kill -0 "$child_pid" 2>/dev/null && running_pid="$child_pid"
        [ -z "$running_pid" ] && [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && running_pid="$pid"
        echo "⏰ Interval: $interval minutes"
        if [ -n "$running_pid" ]; then
            echo "Status: Running (PID: $running_pid)"
            echo "⏱️ Next refresh: ~$(date -d "+$interval minutes" '+%H:%M:%S')"
        else
            echo "🔴 Status: Not running"
        fi
    else
        echo "ℹ️ Periodic refresh is not active"
    fi
}

start_random_mode() {
    local directory="$1"
    local mode="${2:-zoom}"
    local interval="${RANDOM_INTERVAL:-30}"
    [ -d "$directory" ] || { echo "❌ Error: Directory not found"; exit 1; }
    local images=()
    while IFS= read -r -d $'\0' file; do
        images+=("$file")
    done < <(find "$directory" -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" \) -print0)
    [ ${#images[@]} -eq 0 ] && { echo "❌ No images found"; exit 1; }
    echo "📁 Found ${#images[@]} images"
    mkdir -p "$CONFIG_DIR"
    echo "directory=$directory" > "$RANDOM_FILE"
    echo "mode=$mode" >> "$RANDOM_FILE"
    echo "interval=$interval" >> "$RANDOM_FILE"
    echo "pid=$$" >> "$RANDOM_FILE"

    pick_random_image() { echo "${images[$((RANDOM % ${#images[@]}))]}"; }

    local first_image
    first_image=$(pick_random_image)
    set_wallpaper "$first_image" "$mode"
    wait

    (
        exec 9>&-
        while true; do
            sleep $((interval * 60))
            [ -f "$RANDOM_FILE" ] || exit 0
            local new_img
            new_img=$(pick_random_image)
            set_wallpaper "$new_img" "$mode"
            wait
        done
    ) &
    echo $! >> "$RANDOM_FILE"
    disown
}

stop_random_mode() {
    if [ -f "$RANDOM_FILE" ]; then
        kill "$(tail -n1 "$RANDOM_FILE")" 2>/dev/null
        rm -f "$RANDOM_FILE"
        echo "⏹️ Random rotation stopped"
    else
        echo "⚠️ Random rotation not active"
    fi
}

show_random_status() {
    if [ -f "$RANDOM_FILE" ]; then
        local dir mode interval pid
        while IFS='=' read -r key value; do
            case "$key" in
                directory) dir="$value";;
                mode) mode="$value";;
                interval) interval="$value";;
                pid) pid="$value";;
            esac
        done < "$RANDOM_FILE"
        echo "📁 Directory: $dir"
        echo "📐 Mode: $mode"
        echo "⏰ Interval: $interval minutes"
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo "🟢 Running (PID: $pid)"
            local count
            count=$(find "$dir" -type f \( -name "*.jpg" -o -name "*.jpeg" -o -name "*.png" -o -name "*.webp" \) | wc -l)
            echo "📊 Images available: $count"
        else
            echo "🔴 Not running"
        fi
    else
        echo "ℹ️ Random rotation is not active"
    fi
}

set_interval() {
    local interval="$1"
    [[ "$interval" =~ ^[0-9]+$ ]] && [ "$interval" -ge 1 ] || { echo "❌ Invalid interval"; exit 1; }
    RANDOM_INTERVAL="$interval"
    update_config "random_interval" "$interval"
    echo "✅ Interval set to $interval minutes"
    if [ -f "$RANDOM_FILE" ]; then
        local dir mode
        while IFS='=' read -r key value; do
            case "$key" in
                directory) dir="$value";;
                mode) mode="$value";;
            esac
        done < "$RANDOM_FILE"
        stop_random_mode
        [ -n "$dir" ] && start_random_mode "$dir" "$mode"
    fi
}

show_status() {
    load_config
    echo "=== Ultraspan Status ==="
    local current_uri
    current_uri=$(gsettings get org.cinnamon.desktop.background picture-uri 2>/dev/null | sed "s/'//g")
    echo "📷 Current Wallpaper: $current_uri"
    get_total_span
    echo "🖥️  Monitor span: ${TOTAL_WIDTH}x${TOTAL_HEIGHT}"
    echo "⚙️  Mode: $MODE, Background: $BG_TYPE"
    if [ "$BG_TYPE" = "blur" ]; then echo "   Blur: $BLUR_AMOUNT"; else echo "   Color: $BG_COLOR"; fi
    [ -f "$RANDOM_FILE" ] && echo "🎲 Random rotation active"
    [ -f "$REFRESH_FILE" ] && echo "🔄 Periodic refresh active"
    if [ -d "$CACHE_DIR" ]; then
        local count size
        count=$(find "$CACHE_DIR" -name "*.jpg" | wc -l)
        size=$(du -sh "$CACHE_DIR" | cut -f1)
        echo "🗃️  Cache: $count files, $size"
    fi
}

show_image_info() {
    local image="$1"
    [ -f "$image" ] || { echo "❌ Error: File not found"; exit 1; }
    echo "📄 $(basename "$image")"
    echo "📏 $(du -h "$image" | cut -f1)"
    local w h
    w=$($IM_IDENTIFY -format "%w" "$image" 2>/dev/null || echo "Unknown")
    h=$($IM_IDENTIFY -format "%h" "$image" 2>/dev/null || echo "Unknown")
    echo "🖼️  ${w}x${h}"
    get_total_span
    echo "📐 Target span: ${TOTAL_WIDTH}x${TOTAL_HEIGHT}"
}

list_recent() { show_status; }

set_mode() {
    case "$1" in zoom|fit|center) ;; *) echo "❌ Invalid mode"; exit 1 ;; esac
    MODE="$1"
    update_config "mode" "$MODE"
    echo "✅ Default mode: $MODE"
    [ -f "$STATE_FILE" ] && refresh_wallpaper
}

set_bg_type() {
    case "$1" in blur|solid) ;; *) echo "❌ Invalid bg-type"; exit 1 ;; esac
    BG_TYPE="$1"
    update_config "bg_type" "$BG_TYPE"
    echo "✅ Background type: $BG_TYPE"
    [ -f "$STATE_FILE" ] && refresh_wallpaper
}

set_blur() {
    local amt="$1"
    [[ "$amt" =~ ^[0-9]+$ ]] && [ "$amt" -ge 0 ] && [ "$amt" -le 100 ] || { echo "❌ Blur must be 0-100"; exit 1; }
    BLUR_AMOUNT="$amt"
    update_config "blur" "$BLUR_AMOUNT"
    echo "✅ Blur: $BLUR_AMOUNT"
    [ -f "$STATE_FILE" ] && [ "$BG_TYPE" = "blur" ] && refresh_wallpaper
}

set_color() {
    local color="$1"
    color="${color#\#}"
    [[ "$color" =~ ^[0-9A-Fa-f]{6}$ ]] || { echo "❌ Invalid hex color"; exit 1; }
    BG_COLOR="#$color"
    update_config "color" "$BG_COLOR"
    echo "✅ Color: $BG_COLOR"
    [ -f "$STATE_FILE" ] && [ "$BG_TYPE" = "solid" ] && refresh_wallpaper
}

set_fullscreen_pause() {
    local setting="$1"
    case "$setting" in
        on|true|1) FULLSCREEN_PAUSE="true" ;;
        off|false|0) FULLSCREEN_PAUSE="false" ;;
        *) echo "📺 Fullscreen pause: $FULLSCREEN_PAUSE"; return ;;
    esac
    update_config "fullscreen_pause" "$FULLSCREEN_PAUSE"
    echo "✅ Fullscreen pause: $FULLSCREEN_PAUSE"
    if [ -f "$REFRESH_FILE" ]; then
        local interval
        interval=$(head -n1 "$REFRESH_FILE" | cut -d= -f2)
        stop_refresh_mode
        start_refresh_mode "$interval"
    fi
}

clean_cache() {
    echo "🧹 Cleaning cache..."
    if [ -d "$CACHE_DIR" ]; then
        local count size
        count=$(find "$CACHE_DIR" -name "*.jpg" | wc -l)
        size=$(du -sh "$CACHE_DIR" | cut -f1)
        rm -rf "$CACHE_DIR"
        mkdir -p "$CACHE_DIR"
        echo "✅ Removed $count files ($size)"
    fi
}

restore_default() {
    local default_wp="/usr/share/backgrounds/linuxmint/default_background.jpg"
    if [ -f "$default_wp" ]; then
        set_wallpaper "$default_wp" "zoom"
    else
        local alt
        alt=$(find /usr/share/backgrounds /usr/share/wallpapers -name "*.jpg" -o -name "*.png" | head -1)
        [ -n "$alt" ] && set_wallpaper "$alt" "zoom" || echo "❌ No system wallpaper found"
    fi
}

# ---------- DEPENDENCY CHECK ----------
check_dependencies() {
    local missing=()
    for cmd in xrandr gsettings md5sum bc; do
        command -v "$cmd" &>/dev/null || missing+=("$cmd")
    done
    if [ ${#missing[@]} -ne 0 ]; then
        echo "❌ Missing: ${missing[*]}"
        echo "   Install with: sudo apt install imagemagick x11-utils bc"
        exit 1
    fi
    if ! command -v "$IM_CMD" &>/dev/null; then
        echo "❌ ImageMagick not found (tried $IM_CMD)."
        exit 1
    fi
}

# ---------- MAIN DISPATCHER ----------
load_config
check_dependencies

COMMAND="${1:-help}"
case "$COMMAND" in
    set)
        [ -z "${2:-}" ] && { echo "❌ Usage: ultraspan set IMAGE [MODE] [force]"; exit 1; }
        DEFAULT_MODE=$(get_default_mode)
        MODE_TO_USE="${3:-$DEFAULT_MODE}"
        FORCE_FLAG=false
        [ "${4:-}" = "true" ] && FORCE_FLAG=true
        set_wallpaper "$2" "$MODE_TO_USE" "$FORCE_FLAG"
        ;;
    set-per-monitor)
        [ -z "${2:-}" ] && { echo "❌ Usage: ultraspan set-per-monitor IMG1 IMG2 ... [MODE]"; exit 1; }
        shift
        set_per_monitor_wallpaper "$@"
        ;;
    random)
        [ -z "${2:-}" ] && { echo "❌ Usage: ultraspan random DIR [MODE]"; exit 1; }
        stop_random_mode
        DEFAULT_MODE=$(get_default_mode)
        start_random_mode "$2" "${3:-$DEFAULT_MODE}"
        ;;
    random-stop) stop_random_mode ;;
    random-status) show_random_status ;;
    interval)
        [ -z "${2:-}" ] && { echo "⏰ Interval: ${RANDOM_INTERVAL} min"; exit 0; }
        set_interval "$2"
        ;;
    refresh-start)
        stop_refresh_mode
        start_refresh_mode "${2:-180}"
        ;;
    refresh-stop) stop_refresh_mode ;;
    refresh-status) show_refresh_status ;;
    status) show_status ;;
    info)
        [ -z "${2:-}" ] && { echo "❌ Usage: ultraspan info IMAGE"; exit 1; }
        show_image_info "$2"
        ;;
    list) list_recent ;;
    mode)
        [ -z "${2:-}" ] && { echo "📐 Mode: ${MODE:-zoom}"; exit 0; }
        set_mode "$2"
        ;;
    bg-type)
        [ -z "${2:-}" ] && { echo "🎨 Background: $BG_TYPE"; exit 0; }
        set_bg_type "$2"
        ;;
    blur)
        [ -z "${2:-}" ] && { echo "🎭 Blur: $BLUR_AMOUNT"; exit 0; }
        set_blur "$2"
        ;;
    color)
        [ -z "${2:-}" ] && { echo "🎨 Color: $BG_COLOR"; exit 0; }
        set_color "$2"
        ;;
    fullscreen)
        [ -z "${2:-}" ] && { echo "📺 Fullscreen pause: $FULLSCREEN_PAUSE"; exit 0; }
        set_fullscreen_pause "$2"
        ;;
    restore) restore_default ;;
    clean) clean_cache ;;
    help|--help|-h) show_help ;;
    --version) echo "Ultraspan version $VERSION" ;;
    *)
        echo "❌ Unknown command: $1"
        show_help
        exit 1
        ;;
esac
