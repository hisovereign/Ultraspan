            return
        self.config.set('gui_button_color', btn.props.rgba.to_string())
        self._apply_gui_background()

    def _apply_gui_background(self, force_off: bool = False) -> None:
        if not hasattr(self, '_background_provider'):
            return
        if force_off or not self.config.get_bool('gui_skin_enabled'):
            self._background_provider.load_from_data(b'')
            self.remove_css_class('ultraspan-window')
            return

        bg_image = self.config.get('gui_background')
        font_color = self.config.get('gui_font_color')
        button_color = self.config.get('gui_button_color')
        group_opacity = float(self.config.get('gui_group_opacity') or '0')

        parts = []
        if bg_image and os.path.isfile(bg_image):
            parts.append(
                'window.ultraspan-window {'
                f' background-image: url("file://{bg_image}");'
                ' background-size: cover;'
                ' background-position: center;'
                ' }'
            )
        if font_color:
            parts.append(f'window.ultraspan-window * {{ color: {font_color}; }}')
        if button_color:
            parts.append(f'window.ultraspan-window button {{ background-color: {button_color}; }}')
        if group_opacity > 0:
            parts.append(f'window.ultraspan-window preferencesgroup {{ background-color: rgba(0, 0, 0, {group_opacity}); }}')

        if parts:
            self.add_css_class('ultraspan-window')
        else:
            self.remove_css_class('ultraspan-window')

        self._background_provider.load_from_data(''.join(parts).encode() if parts else b'')

    # ------------------------------------------------------------------
    # Utilities
    # ------------------------------------------------------------------
    def _get_index(self, model, val: str) -> int:
        for i in range(model.get_n_items()):
            if model.get_string(i) == val:
                return i
        return 0

    def _run_ultraspan(self, args: list[str]):
        try:
            result = subprocess.run(
                [SCRIPT_PATH] + args,
                capture_output=True, text=True, timeout=120, check=False
            )
            return result.stdout.strip(), result.stderr.strip(), result.returncode
        except (subprocess.TimeoutExpired, FileNotFoundError, OSError) as e:
            return "", str(e), 1

    def _run_ultraspan_async(self, args: list[str]) -> None:
        threading.Thread(target=lambda: self._run_ultraspan(args), daemon=True).start()

    def _create_color_button(self, current_hex: str, callback) -> object:
        gtk = GTK
        rgba = gtk['Gdk'].RGBA()
        rgba.parse(current_hex if current_hex else '#000000')
        dialog = gtk['Gtk'].ColorDialog.new()
        dialog.set_title("Choose color")
        btn = gtk['Gtk'].ColorDialogButton.new(dialog)
        btn.props.rgba = rgba
        btn.set_size_request(24, 24)
        btn.set_halign(gtk['Gtk'].Align.CENTER)
        btn.set_valign(gtk['Gtk'].Align.CENTER)
        btn.set_margin_start(0)
        btn.set_margin_end(0)
        btn.connect('notify::rgba', callback)
        return btn

    # ------------------------------------------------------------------
    # Widget sync
    # ------------------------------------------------------------------
    def _update_all_widgets(self, *args) -> None:
        gtk = GTK
        self._updating_widgets = True
        try:
            self.config.load()
            self.backend_row.set_selected(self._get_index(self.backend_row.get_model(), self.config.get('backend')))

            new_fs = self.config.get_bool('fullscreen_pause')
            if self.fullscreen_row.get_active() != new_fs:
                self.fullscreen_row.set_active(new_fs)

            if hasattr(self, 'video_grace_spin'):
                self.video_grace_spin.set_value(self.config.get_int('fullscreen_grace_seconds'))

            if hasattr(self, 'click_relower_row'):
                daemon_cfg = read_daemon_config()
                current = daemon_cfg.get('click_relower', 'true').lower() in ('true', 'yes', '1', 'on')
                if self.click_relower_row.get_active() != current:
                    self.click_relower_row.set_active(current)

            if hasattr(self, '_gui_bg_switch') and self._gui_bg_switch is not None:
                skin = self.config.get_bool('gui_skin_enabled')
                if self._gui_bg_switch.get_active() != skin:
                    self._gui_bg_switch.set_active(skin)
                self._apply_gui_background()

            if hasattr(self, '_gui_font_color_btn') and self._gui_font_color_btn is not None:
                rgba = gtk['Gdk'].RGBA()
                rgba.parse(self.config.get('gui_font_color') or '#000000')
                self._gui_font_color_btn.props.rgba = rgba

            if hasattr(self, '_gui_button_color_btn') and self._gui_button_color_btn is not None:
                rgba = gtk['Gdk'].RGBA()
                rgba.parse(self.config.get('gui_button_color') or '#000000')
                self._gui_button_color_btn.props.rgba = rgba

            if self._autostart_daemon_switch is not None:
                auto = self._is_autostart_enabled()
                if self._autostart_daemon_switch.get_active() != auto:
                    self._autostart_daemon_switch.set_active(auto)

            if hasattr(self, '_gui_group_opacity_scale') and self._gui_group_opacity_scale is not None:
                new_op = float(self.config.get('gui_group_opacity') or '0')
                if abs(self._gui_group_opacity_scale.get_value() - new_op) > 0.001:
                    self._gui_group_opacity_scale.set_value(new_op)

            new_ws = self.config.get_bool('per_workspace')
            if self.workspace_row.get_active() != new_ws:
                self.workspace_row.set_active(new_ws)

            self.mode_row.set_selected(self._get_index(self.mode_row.get_model(), self.config.get('mode')))
            self.bg_type_row.set_selected(self._get_index(self.bg_type_row.get_model(), self.config.get('bg_type')))
            self.blur_scale.set_value(self.config.get_int('blur'))

            rgba = gtk['Gdk'].RGBA()
            color_str = self.config.get('color')
            rgba.parse(color_str if color_str else '#000000')
            self.color_btn.props.rgba = rgba

            self.folder_button.set_label(self.config.get('wallpaper_folder'))
            self._populate_wallpaper_list_async()

            self.random_spin.set_value(self.config.get_int('random_interval'))
            new_mr = self.config.get_bool('multi_random')
            if self.multi_random_row.get_active() != new_mr:
                self.multi_random_row.set_active(new_mr)
            self.refresh_spin.set_value(self.config.get_int('refresh_interval'))
            self._update_service_status()
        finally:
            self._updating_widgets = False

    # ------------------------------------------------------------------
    # Monitors for config / daemon
    # ------------------------------------------------------------------
    def _monitor_config(self) -> None:
        gtk = GTK
        def cb(file, other, event, data) -> None:
            if event in (gtk['Gio'].FileMonitorEvent.CHANGED,
                         gtk['Gio'].FileMonitorEvent.CHANGES_DONE_HINT):
                gtk['GLib'].idle_add(self._update_all_widgets)
        if os.path.exists(CONFIG_FILE):
            f = gtk['Gio'].File.new_for_path(CONFIG_FILE)
            self.monitor = f.monitor(gtk['Gio'].FileMonitorFlags.NONE, None)
            self.monitor.connect('changed', cb)

    def _monitor_daemon(self) -> None:
        gtk = GTK
        if os.path.exists(DAEMON_PID_FILE):
            f = gtk['Gio'].File.new_for_path(DAEMON_PID_FILE)
            self.daemon_monitor = f.monitor(gtk['Gio'].FileMonitorFlags.NONE, None)
            self.daemon_monitor.connect('changed',
                lambda *a: gtk['GLib'].idle_add(self._update_service_status))
        else:
            dir_path = os.path.dirname(DAEMON_PID_FILE)
            if os.path.exists(dir_path):
                f = gtk['Gio'].File.new_for_path(dir_path)
                self.daemon_monitor = f.monitor(gtk['Gio'].FileMonitorFlags.NONE, None)
                self.daemon_monitor.connect('changed',
                    lambda *a: gtk['GLib'].idle_add(self._update_service_status))


class UltraspanApp:
    def __init__(self) -> None:
        gtk = GTK
        self.app = gtk['Adw'].Application.new(APP_ID, gtk['Gio'].ApplicationFlags.FLAGS_NONE)
        self.app.connect('activate', self.do_activate)
        self.window = None

    def do_activate(self, app) -> None:
        if not self.window:
            self.window = UltraspanWindow(self)
            self.app.add_window(self.window)
        self.window.present()
        gtk = GTK
        gtk['GLib'].idle_add(self.window._populate_wallpaper_list_async)

    def run(self, args: list[str]) -> int:
        return self.app.run(args)


def main() -> int:
    os.makedirs(CONFIG_DIR, exist_ok=True)
    app = UltraspanApp()
    return app.run(sys.argv)


if __name__ == '__main__':
    main()
