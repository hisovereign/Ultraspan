    # ------------------------------------------------------------------
    # Monitor list
    # ------------------------------------------------------------------
    def _populate_monitor_list(self) -> None:
        gtk = GTK
        for _ in range(1000):
            child = self.monitor_list_box.get_first_child()
            if child is None:
                break
            self.monitor_list_box.remove(child)
        try:
            result = subprocess.run(['xrandr', '--listmonitors'],
                                    capture_output=True, text=True, timeout=5, check=False)
            lines = result.stdout.splitlines()
            monitors = []
            for line in lines[1:]:
                parts = line.split()
                monitors.append(parts[-1] if len(parts) >= 4 else line.strip())
        except (OSError, subprocess.TimeoutExpired):
            monitors = []
        self.monitor_count = len(monitors)
        self.per_monitor_slots = [None] * self.monitor_count
        if not monitors:
            self.monitor_list_box.append(gtk['Gtk'].Label.new("No monitors detected"))
            return
        for i, name in enumerate(monitors):
            lbl = gtk['Gtk'].Label.new(f"{i+1}: {name}")
            lbl.set_xalign(0.0)
            self.monitor_list_box.append(lbl)

    # ------------------------------------------------------------------
    # Autostart
    # ------------------------------------------------------------------
    def _autostart_file_path(self) -> str:
        return os.path.expanduser('~/.config/autostart/ultraspan-daemon.desktop')

    def _is_autostart_enabled(self) -> bool:
        return os.path.exists(self._autostart_file_path())

    def _on_autostart_daemon_toggled(self, row, *args) -> None:
        if getattr(self, '_updating_widgets', False):
            return
        enabled = row.get_active()
        autostart_file = self._autostart_file_path()
        helper_path = os.path.expanduser('~/.local/bin/ultraspan-autostart')
        if enabled:
            os.makedirs(os.path.dirname(autostart_file), exist_ok=True)
            os.makedirs(os.path.dirname(helper_path), exist_ok=True)
            script_path = shutil.which('ultraspan') or os.path.expanduser('~/.local/bin/ultraspan')
            with open(helper_path, 'w') as f:
                f.write("#!/bin/bash\n")
                f.write("sleep 3\n")
                f.write(f"setsid nohup {script_path} daemon >/dev/null 2>&1 &\n")
            os.chmod(helper_path, 0o755)
            with open(autostart_file, 'w') as f:
                f.write("[Desktop Entry]\n")
                f.write("Type=Application\n")
                f.write("Name=Ultraspan Daemon\n")
                f.write(f"Exec={helper_path}\n")
                f.write("X-GNOME-Autostart-enabled=true\n")
        else:
            for p in (autostart_file, helper_path):
                try:
                    os.remove(p)
                except FileNotFoundError:
                    pass

    # ------------------------------------------------------------------
