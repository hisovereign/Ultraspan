    # ------------------------------------------------------------------
    # Mode toggle and grid filter
    # ------------------------------------------------------------------
    def _on_wallpaper_mode_toggled(self, btn) -> None:
        if not btn.get_active():
            return
        # Move the suggested-action class to whichever toggle is active.
        for b in (self.mode_wallpaper_btn, self.mode_per_monitor_btn, self.mode_video_btn):
            if b.get_active():
                b.add_css_class("suggested-action")
            else:
                b.remove_css_class("suggested-action")
        self._apply_grid_filter()
        self._refresh_selection_highlight()

    def _apply_grid_filter(self) -> None:
        mode = self._current_mode()
        child = self.wallpaper_flowbox.get_first_child()
        while child is not None:
            is_vid = getattr(child, 'is_video', False)
            if mode == 'video':
                child.set_visible(is_vid)
            else:
                # Wallpaper and Per-Monitor show everything.
                child.set_visible(True)
            child = child.get_next_sibling()

    def _refresh_selection_highlight(self) -> None:
        # Clear selection CSS on every child first.
        child = self.wallpaper_flowbox.get_first_child()
        while child is not None:
            child.remove_css_class('selected')
            if hasattr(child, 'badge_label'):
                child.badge_label.set_visible(False)
                child.badge_label.set_text("")
            child = child.get_next_sibling()
        # Re-apply for the current mode.
        mode = self._current_mode()
        if mode == 'wallpaper':
            if self.wallpaper_selection is not None:
                self.wallpaper_selection.add_css_class('selected')
        elif mode == 'per_monitor':
            for i, slot_child in enumerate(self.per_monitor_slots):
                if slot_child is not None:
                    slot_child.add_css_class('selected')
                    if hasattr(slot_child, 'badge_label'):
                        slot_child.badge_label.set_text(str(i + 1))
                        slot_child.badge_label.set_visible(True)
        elif mode == 'video':
            for c in self.video_selections:
                c.add_css_class('selected')
                if hasattr(c, 'badge_label'):
                    c.badge_label.set_text(str(c.assigned_monitor + 1))
                    c.badge_label.set_visible(True)

    # ------------------------------------------------------------------
    # Selection click handling
    # ------------------------------------------------------------------
    def _on_child_clicked(self, gesture, n_press, x, y, child) -> None:
        mode = self._current_mode()
        if mode == 'wallpaper':
            self._handle_single_click(child)
        elif mode == 'per_monitor':
            self._handle_slot_click(child, self.per_monitor_slots)
        elif mode == 'video':
            self._handle_video_click(child)

    def _handle_single_click(self, child) -> None:
        if self.wallpaper_selection is child:
            self.wallpaper_selection = None
            child.remove_css_class('selected')
            return
        if self.wallpaper_selection is not None:
            self.wallpaper_selection.remove_css_class('selected')
        self.wallpaper_selection = child
        child.add_css_class('selected')

    def _handle_slot_click(self, child, slots) -> None:
        # Deselect if already in a slot.
        for i, c in enumerate(slots):
            if c is child:
                slots[i] = None
                child.remove_css_class('selected')
                if hasattr(child, 'badge_label'):
                    child.badge_label.set_visible(False)
                    child.badge_label.set_text("")
                return
        try:
            slot = slots.index(None)
        except ValueError:
            return
        if sum(1 for s in slots if s is not None) >= self._get_current_max_allowed():
            return
        slots[slot] = child
        child.add_css_class('selected')
        if hasattr(child, 'badge_label'):
            child.badge_label.set_text(str(slot + 1))
            child.badge_label.set_visible(True)

    def _handle_video_click(self, child) -> None:
        # Deselect if already selected.
        if child in self.video_selections:
            self.video_selections.remove(child)
            child.remove_css_class('selected')
            if hasattr(child, 'badge_label'):
                child.badge_label.set_visible(False)
                child.badge_label.set_text("")
            return
        if len(self.video_selections) >= self.monitor_count:
            return
        used = {c.assigned_monitor for c in self.video_selections}
        free = next((i for i in range(self.monitor_count) if i not in used), None)
        if free is None:
            return
        child.assigned_monitor = free
        self.video_selections.append(child)
        child.add_css_class('selected')
        if hasattr(child, 'badge_label'):
            child.badge_label.set_text(str(free + 1))
            child.badge_label.set_visible(True)

    def _handle_badge_click(self, gesture, n_press, x, y, child) -> None:
        mode = self._current_mode()
        if mode == 'video':
            used = {c.assigned_monitor for c in self.video_selections if c is not child}
            if self.monitor_count == 0:
                return
            nxt = (child.assigned_monitor + 1) % self.monitor_count
            # Skip monitors taken by other selected videos.
            for _ in range(self.monitor_count):
                if nxt not in used:
                    break
                nxt = (nxt + 1) % self.monitor_count
            child.assigned_monitor = nxt
            child.badge_label.set_text(str(nxt + 1))
        else:
            self._on_child_clicked(None, 0, 0, 0, child)
        gesture.set_state(GTK['Gtk'].EventSequenceState.CLAIMED)

    def _on_child_key_pressed(self, controller, keyval, keycode, state, child) -> bool:
        gtk = GTK
        if keyval in (gtk['Gdk'].KEY_Return, gtk['Gdk'].KEY_KP_Enter, gtk['Gdk'].KEY_space):
            self._on_child_clicked(None, 0, 0, 0, child)
            return True
        return False

    # ------------------------------------------------------------------
    # Apply
    # ------------------------------------------------------------------
    def _on_apply_clicked(self, btn) -> None:
        mode = self._current_mode()
        config_mode = self.config.get('mode')
        cmd_list = []

        if mode == 'wallpaper':
            if self.wallpaper_selection is None:
                return
            path = getattr(self.wallpaper_selection, 'path', None)
            if not path:
                return
            if is_video_path(path):
                # Full-span video. Doesn't touch the underlying wallpaper.
                cmd_list.append(["set-video", path])
            else:
                # Image: kill any running video, then set the image.
                cmd_list.append(["stop-video"])
                cmd_list.append(["set", path, config_mode])

        elif mode == 'per_monitor':
            slot_paths = []
            for child in self.per_monitor_slots:
                if child is None:
                    slot_paths.append("none")
                else:
                    p = getattr(child, 'path', None)
                    slot_paths.append(p if p else "none")
            if all(p == "none" for p in slot_paths):
                return
            # set-media stops any running video and rebuilds the mixed canvas.
            cmd_list.append(["set-media"] + slot_paths)

        elif mode == 'video':
            if not self.video_selections:
                return
            pairs = []
            for c in self.video_selections:
                p = getattr(c, 'path', None)
                if p:
                    pairs.append(f"{c.assigned_monitor}:{p}")
            if not pairs:
                return
            cmd_list.append(["set-video-on"] + pairs)

        if not cmd_list:
            return

        def run() -> None:
            for cmd in cmd_list:
                self._run_ultraspan(cmd)

        threading.Thread(target=run, daemon=True).start()
        btn.set_label("Applied!")
        GTK['GLib'].timeout_add(1500, lambda: btn.set_label("Apply"))

    # ------------------------------------------------------------------
    # Populate grid
    # ------------------------------------------------------------------
    def _populate_wallpaper_list_async(self) -> None:
        gtk = GTK
        folder = self.config.get('wallpaper_folder')
        if not os.path.isdir(folder):
            return
        try:
            files = sorted([f for f in os.listdir(folder) if f.lower().endswith(ALL_EXTENSIONS)])
        except OSError:
            files = []

        # Clear existing.
        child = self.wallpaper_flowbox.get_first_child()
        while child is not None:
            nxt = child.get_next_sibling()
            self.wallpaper_flowbox.remove(child)
            child = nxt

        # Clearing the grid invalidates any selection state.
        self.wallpaper_selection = None
        self.per_monitor_slots = [None] * self.monitor_count
        self.video_selections = []

        if not files:
            return
        paths = [os.path.join(folder, f) for f in files]

        def load() -> None:
            for idx, path in enumerate(paths):
                try:
                    pixbuf = build_media_pixbuf(gtk, path)
                except Exception as e:  # noqa: BLE001 — one bad file must not kill the whole thumbnail pass
                    print(f"[thumb] fatal: {path}: {e}", file=sys.stderr)
                    continue
                gtk['GLib'].idle_add(self._add_thumbnail_to_flowbox, path, pixbuf)

        threading.Thread(target=load, daemon=True).start()

    def _add_thumbnail_to_flowbox(self, path: str, pixbuf) -> None:
        gtk = GTK
        child = gtk['Gtk'].FlowBoxChild.new()
        child.path = path
        child.is_video = is_video_path(path)
        child.assigned_monitor = 0
        child.set_focusable(True)

        texture = gtk['Gdk'].Texture.new_for_pixbuf(pixbuf)
        picture = gtk['Gtk'].Picture.new_for_paintable(texture)
        picture.set_can_shrink(True)
        picture.set_size_request(134, 134)
        picture.set_halign(gtk['Gtk'].Align.CENTER)
        picture.set_valign(gtk['Gtk'].Align.START)

        badge = gtk['Gtk'].Label.new("")
        badge.set_halign(gtk['Gtk'].Align.START)
        badge.set_valign(gtk['Gtk'].Align.START)
        badge.set_margin_start(2)
        badge.set_margin_top(2)
        badge.add_css_class("badge")
        badge.set_visible(False)

        overlay = gtk['Gtk'].Overlay.new()
        overlay.set_valign(gtk['Gtk'].Align.START)
        overlay.set_halign(gtk['Gtk'].Align.CENTER)
        overlay.set_child(picture)
        overlay.add_overlay(badge)

        if child.is_video:
            vid_tag = gtk['Gtk'].Label.new("VIDEO")
            vid_tag.set_halign(gtk['Gtk'].Align.END)
            vid_tag.set_valign(gtk['Gtk'].Align.START)
            vid_tag.set_margin_end(4)
            vid_tag.set_margin_top(4)
            vid_tag.add_css_class("video-badge")
            overlay.add_overlay(vid_tag)

        child.badge_label = badge

        vbox = gtk['Gtk'].Box.new(gtk['Gtk'].Orientation.VERTICAL, 0)
        vbox.set_spacing(0)
        vbox.append(overlay)
        label = gtk['Gtk'].Label.new(os.path.basename(path))
        label.set_xalign(0.5)
        label.set_valign(gtk['Gtk'].Align.START)
        label.set_wrap(True)
        label.set_max_width_chars(15)
        label.set_ellipsize(3)
        vbox.append(label)
        child.set_child(vbox)

        # Main click gesture on the child.
        click_gesture = gtk['Gtk'].GestureClick.new()
        click_gesture.connect('pressed', self._on_child_clicked, child)
        child.add_controller(click_gesture)

        # Separate gesture on the badge. Capture phase so it wins over the child.
        badge_gesture = gtk['Gtk'].GestureClick.new()
        badge_gesture.set_propagation_phase(gtk['Gtk'].PropagationPhase.CAPTURE)
        badge_gesture.connect('pressed', self._handle_badge_click, child)
        badge.add_controller(badge_gesture)

        key_controller = gtk['Gtk'].EventControllerKey.new()
        key_controller.connect('key-pressed', self._on_child_key_pressed, child)
        child.add_controller(key_controller)

        self.wallpaper_flowbox.append(child)
        child.add_css_class('wallpaper-child')

        # Apply current mode filter to the new child immediately.
        mode = self._current_mode()
        if mode == 'video':
            child.set_visible(child.is_video)
        else:
            child.set_visible(True)

