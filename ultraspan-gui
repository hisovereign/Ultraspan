        self._run_ultraspan_async(["set-config", "per_workspace", str(val).lower()])
        if val and not self._is_daemon_running():
            self._run_ultraspan_async(["daemon"])
            GTK['GLib'].timeout_add(2500, self._update_service_status)

    def _on_mode_changed(self, row, *args) -> None:
