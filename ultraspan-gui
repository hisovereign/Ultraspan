    def _on_restart_video_clicked(self, btn) -> None:
        script_pid_file = os.path.expanduser('~/.config/ultraspan/video.pid')
        daemon_pid_file = f'/run/user/{os.getuid()}/ultraspan/video-daemon.pid'

        # Find the live daemon pid from either tracker.
        pid = None
        for pf in (script_pid_file, daemon_pid_file):
            try:
                with open(pf) as f:
                    candidate = int(f.read().strip())
                os.kill(candidate, 0)  # probe
                pid = candidate
                break
            except (OSError, ValueError, FileNotFoundError):
                continue

        if pid is None:
            self._flash_button(btn, "No video running")
            return

        # Read argv before killing.
        try:
            with open(f'/proc/{pid}/cmdline', 'rb') as f:
                raw = f.read()
            args = [a.decode(errors='replace') for a in raw.split(b'\0') if a]
        except OSError:
            self._flash_button(btn, "Cmdline unavailable")
            return

        if not args:
            self._flash_button(btn, "Empty cmdline")
            return

        # Kill the daemon directly (SIGTERM), then remove stale pid files.
        try:
            os.kill(pid, 15)
        except OSError:
            pass
        for pf in (script_pid_file, daemon_pid_file):
            try:
                os.remove(pf)
            except FileNotFoundError:
                pass

        def relaunch():
            import time
            # Wait for the old process to fully exit (up to 3s).
            for _ in range(30):
                try:
                    os.kill(pid, 0)
                    time.sleep(0.1)
                except OSError:
                    break

            try:
                proc = subprocess.Popen(
                    args,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    start_new_session=True,
                )
            except OSError as e:
                print(f"[restart] failed: {e}", file=sys.stderr)
                return

            # Give the daemon a moment to settle, then write the script's
            # tracker so `ultraspan stop-video` keeps working.
            time.sleep(0.6)
            try:
                with open(script_pid_file, 'w') as f:
                    f.write(str(proc.pid))
            except OSError as e:
                print(f"[restart] pid-file write failed: {e}", file=sys.stderr)

        threading.Thread(target=relaunch, daemon=True).start()
        self._flash_button(btn, "Restarting…")

    def _flash_button(self, btn, text: str) -> None:
        original = btn.get_label()
        btn.set_label(text)
        GTK['GLib'].timeout_add(1500, lambda: btn.set_label(original) or False)

