# ----------------------------------------------------------------------
# Config handler (script config: ~/.config/ultraspan/config)
# ----------------------------------------------------------------------
class UltraspanConfig:
    def __init__(self) -> None:
        self.defaults = {
            'mode': 'zoom',
            'bg_type': 'blur',
            'blur': '15',
            'color': '#000000',
            'fullscreen_pause': 'true',
            'fullscreen_grace_seconds': '5',
            'video_slice_fps': '30',
            'video_slice_crf': '18',
            'random_interval': '30',
            'refresh_interval': '480',
            'multi_random': 'false',
            'backend': 'gsettings',
            'max_cache_mb': '2000',
            'magick_memory': '2GiB',
            'per_workspace': 'false',
            'gui_background': '',
            'gui_font_color': '',
            'gui_button_color': '',
            'gui_group_opacity': '0',
            'gui_skin_enabled': 'false',
            'wallpaper_folder': DEFAULT_FOLDER,
        }
        self.values = self.defaults.copy()
        self.load()

    def load(self) -> None:
        if not os.path.exists(CONFIG_FILE):
            return
        with open(CONFIG_FILE, 'r') as f:
            for line in f:
                line = line.strip()
                if '=' not in line:
                    continue
                key, val = line.split('=', 1)
                key = key.strip()
                val = val.strip()
                if key in self.values:
                    self.values[key] = val

    def save(self) -> None:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(CONFIG_FILE, 'w') as f:
            f.writelines(f"{key}={val}\n" for key, val in self.values.items())

    def get(self, key: str) -> str:
        assert key in self.defaults, f"Unknown config key: {key}"
        return self.values.get(key, self.defaults.get(key, ''))

    def set(self, key: str, val: object) -> None:
        assert key in self.defaults, f"Unknown config key: {key}"
        self.values[key] = str(val)
        self.save()

    def get_int(self, key: str) -> int:
        assert key in self.defaults, f"Unknown config key: {key}"
        try:
            return int(self.get(key))
        except (ValueError, TypeError):
            return int(self.defaults.get(key, '0'))

    def get_bool(self, key: str) -> bool:
        assert key in self.defaults, f"Unknown config key: {key}"
        return self.get(key).lower() in ('true', 'yes', '1', 'on')


# ----------------------------------------------------------------------
# Daemon config helpers (video-daemon.conf)
# ----------------------------------------------------------------------
def read_daemon_config() -> dict:
    out = {}
    if not os.path.exists(DAEMON_CONFIG_FILE):
        return out
    with open(DAEMON_CONFIG_FILE) as f:
        for line in f:
            stripped = line.strip()
            if not stripped or stripped.startswith('#') or '=' not in stripped:
                continue
            k, v = stripped.split('=', 1)
            out[k.strip()] = v.strip()
    return out


def write_daemon_config(updates: dict) -> None:
    os.makedirs(os.path.dirname(DAEMON_CONFIG_FILE), exist_ok=True)
    lines = []
    seen = set()
    if os.path.exists(DAEMON_CONFIG_FILE):
        with open(DAEMON_CONFIG_FILE) as f:
            for line in f:
                stripped = line.strip()
                if stripped and not stripped.startswith('#') and '=' in stripped:
                    k = stripped.split('=', 1)[0].strip()
                    if k in updates:
                        lines.append(f"{k}={updates[k]}\n")
                        seen.add(k)
                        continue
                lines.append(line)
    for k, v in updates.items():
        if k not in seen:
            lines.append(f"{k}={v}\n")
    with open(DAEMON_CONFIG_FILE, 'w') as f:
        f.writelines(lines)


# ----------------------------------------------------------------------
# Media helpers
# ----------------------------------------------------------------------
def is_video_path(path: str) -> bool:
    return path.lower().endswith(VIDEO_EXTENSIONS)


def get_thumbnail_path(media_path: str, size: int = 120) -> str:
    os.makedirs(THUMBNAIL_CACHE, exist_ok=True)
    try:
        mtime = os.path.getmtime(media_path)
    except OSError:
        mtime = 0
    key = f"{media_path}_{mtime}_{size}"
    hash_name = hashlib.md5(key.encode()).hexdigest()
    return os.path.join(THUMBNAIL_CACHE, f"{hash_name}.png")


def generate_video_thumbnail(video_path: str, thumb_path: str, size: int = 134) -> bool:
    try:
        result = subprocess.run(
            ['ffmpeg', '-y', '-loglevel', 'error',
             '-ss', '1', '-i', video_path,
             '-vframes', '1',
             '-vf', f'scale={size}:{size}:force_original_aspect_ratio=decrease',
             thumb_path],
            capture_output=True, timeout=20, check=False
        )
        return result.returncode == 0 and os.path.exists(thumb_path)
    except (OSError, subprocess.TimeoutExpired):
        return False


def build_media_pixbuf(gtk, path: str):
    thumb_path = get_thumbnail_path(path, size=134)
    pixbuf = None

    if os.path.exists(thumb_path):
        try:
            pixbuf = gtk['GdkPixbuf'].Pixbuf.new_from_file(thumb_path)
        except gtk['GLib'].Error:
            pixbuf = None

        else:
            try:
                pixbuf = gtk['GdkPixbuf'].Pixbuf.new_from_file_at_scale(path, 134, 134, True)
                try:
                    pixbuf.savev(thumb_path, 'png', [], [])
                except (gtk['GLib'].Error, OSError):
                    pass
            except (gtk['GLib'].Error, OSError, ValueError) as e:
                print(f"[thumb] decode failed: {path}: {type(e).__name__}: {e}", file=sys.stderr)
                pixbuf = None

    if pixbuf is None:
        pixbuf = gtk['GdkPixbuf'].Pixbuf.new(
            gtk['GdkPixbuf'].Colorspace.RGB, False, 8, 134, 134
        )
        pixbuf.fill(0x3a3a3aff)
    return pixbuf


def create_spin_row(title, subtitle, min_val, max_val, step, initial, on_changed):
    gtk = GTK
    row = gtk['Adw'].ActionRow.new()
    row.set_title(title)
    if subtitle:
        row.set_subtitle(subtitle)
    spin = gtk['Gtk'].SpinButton.new_with_range(min_val, max_val, step)
    spin.set_value(initial)
    spin.connect('value-changed', on_changed)
    row.add_suffix(spin)
    row.set_activatable_widget(spin)
    return row, spin


